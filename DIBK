local function getCurrentScooter()
    local character = player.Character
    if not character then
        return nil, nil, nil
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local seat = humanoid and humanoid.SeatPart
    if not seat or not seat:IsA("VehicleSeat") then
        return nil, nil, nil
    end
    if seat:GetAttribute("IsScooterSeat") ~= true then
        return nil, nil, nil
    end

    local model = seat.Parent
    while model and model ~= workspace and not CollectionService:HasTag(model, "Scooter") do
        model = model.Parent
    end
    if not model or model == workspace then
        return nil, nil, nil
    end

    local chassis = model:FindFirstChild("Chassis")
    if not chassis or not chassis:IsA("BasePart") then
        return nil, nil, nil
    end

    return model, seat, chassis
end

