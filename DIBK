end

local function flatUnit(vector)
    local flat = Vector3.new(vector.X, 0, vector.Z)
    if flat.Magnitude < 0.001 then
        return Vector3.zero
    end
    return flat.Unit
end

local function makeRaycastParams(model)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local excluded = { model }
    if player.Character then
        table.insert(excluded, player.Character)
    end
    params.FilterDescendantsInstances = excluded
    params.IgnoreWater = true
    return params
end

local function steerToward(chassis, target)
    local direction = flatUnit(target - chassis.Position)
    local forward = flatUnit(chassis.CFrame.LookVector)
    if direction == Vector3.zero or forward == Vector3.zero then
        return 0, 0
    end

    -- right vector สำหรับ forward แนวราบ; target อยู่ขวาจะได้ steering เป็นบวก
    local right = Vector3.new(-forward.Z, 0, forward.X)
    local angle = math.atan2(direction:Dot(right), direction:Dot(forward))
    local steer = math.clamp(angle / STEER_RESPONSE_ANGLE, -1, 1)
    return steer, angle
end

local function avoidObstacle(model, chassis, steer, throttle, currentSpeedKmh, angle)
    if not avoidObstacles then
        return steer, throttle, false
    end

    local forward = flatUnit(chassis.CFrame.LookVector)
    if forward == Vector3.zero then
        return steer, throttle, false
    end

    local right = Vector3.new(-forward.Z, 0, forward.X)
    local rayLength = math.clamp(10 + currentSpeedKmh * 0.08, 10, 24)
    local origin = chassis.Position + Vector3.new(0, 2.2, 0)
    local params = makeRaycastParams(model)
    local ahead = workspace:Raycast(origin, forward * rayLength, params)

    if not ahead or not ahead.Instance or not ahead.Instance.CanCollide then
        return steer, throttle, false
    end

    local leftDirection = (forward - right * 0.6).Unit
    local rightDirection = (forward + right * 0.6).Unit
    local leftHit = workspace:Raycast(origin, leftDirection * rayLength, params)
    local rightHit = workspace:Raycast(origin, rightDirection * rayLength, params)

    if not rightHit then
        steer = 0.85
        throttle = math.min(throttle, 0.35)
    elseif not leftHit then
        steer = -0.85
        throttle = math.min(throttle, 0.35)
    else
        -- ทางแคบหรือถูกบังทั้งสองด้าน ให้ชะลอแทนการเร่งชน
        steer = math.abs(angle) > 0.12 and math.sign(angle) or 0
        throttle = -0.25
    end

    return steer, throttle, true
end

local function getThrottleForSpeed(targetSpeedKmh, currentSpeedKmh)
    local difference = targetSpeedKmh - currentSpeedKmh
    if difference > 10 then
        return 1
    elseif difference > 3 then
        return 0.55
    elseif difference > 0.5 then
        return 0.25
    elseif difference < -12 then
        return -0.35
    elseif difference < -5 then
        return -0.15
    end
    return 0
end

