local function setStatus(text, color)
    lastStatus = text
    statusLabel.Text = "สถานะ: " .. text
    statusLabel.TextColor3 = color or COLORS.yellow
end

local function refreshRouteList()
    if #waypoints == 0 then
        routeBox.Text = "ยังไม่มีจุดหมาย  •  เพิ่มพิกัด X/Y/Z หรือบันทึกตำแหน่งรถ"
        routeBox.TextColor3 = COLORS.muted
        return
    end

    local lines = {}
    local displayStart = math.max(1, #waypoints - 5)
    for i = displayStart, #waypoints do
        local point = waypoints[i]
        local marker = (driving and i == waypointIndex) and "▶" or " "
        table.insert(lines, string.format("%s %02d) X %.0f   Y %.0f   Z %.0f", marker, i, point.X, point.Y, point.Z))
    end
    if displayStart > 1 then
        table.insert(lines, 1, string.format("... อีก %d จุด ...", displayStart - 1))
    end
    routeBox.Text = table.concat(lines, "\n")
    routeBox.TextColor3 = COLORS.text
end

local function stopDriving(reason)
    driving = false
    releaseAutoInput()
    if reason then
        setStatus(reason, COLORS.yellow)
    else
        setStatus("หยุดแล้ว", COLORS.red)
    end
    refreshRouteList()
end

local function setSpeedFromX(x)
    local startX = sliderTrack.AbsolutePosition.X
    local width = math.max(sliderTrack.AbsoluteSize.X, 1)
    local alpha = math.clamp((x - startX) / width, 0, 1)
    desiredSpeedKmh = math.floor(MIN_SPEED_KMH + alpha * (MAX_SPEED_KMH - MIN_SPEED_KMH) + 0.5)
    local snappedAlpha = (desiredSpeedKmh - MIN_SPEED_KMH) / (MAX_SPEED_KMH - MIN_SPEED_KMH)
    sliderFill.Size = UDim2.new(snappedAlpha, 0, 1, 0)
    sliderKnob.Position = UDim2.new(snappedAlpha, 0, 0.5, 0)
    speedLabel.Text = tostring(desiredSpeedKmh) .. " km/h"
end

local function beginSliderDrag(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingSlider = true
        setSpeedFromX(input.Position.X)
    end
end

