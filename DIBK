-- Bike Universe | Teleport ไปจุดที่ได้เงินเยอะที่สุด (Tween อิสระ + ปรับความเร็วได้)
local WindUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"))()

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local lp = Players.LocalPlayer

local speed = 500        -- studs/วินาที
local heightOffset = 6
local currentTween      -- {cancel=function}
local selected = "Best Race (Prize สูงสุด)"

-- ===== หา root ที่จะเคลื่อน (บอกถ้านั่งบนไบค์ จะเลื่อนทั้งคัน) =====
local function getMover()
    local char = lp.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local seat = hum and hum.SeatPart
    if seat then
        local model = seat:FindFirstAncestorOfClass("Model")
        if model and model ~= char then return model, true end
    end
    return char, false
end

local function pivotOf(m) return m:GetPivot() end

-- ===== Tween อิสระ: เคลื่อนด้วย speed คงที่ (ปรับได้ระหว่างเดิน) =====
local function stopTween()
    if currentTween then currentTween.cancel() currentTween = nil end
end

local function flyTo(targetPos)
    stopTween()
    local mover = getMover()
    if not mover then return WindUI:Notify({Title="Error", Content="ไม่พบตัวละคร", Duration=3}) end
    local cancelled = false
    local conn
    local function restore()
        if conn then conn:Disconnect() end
    end
    currentTween = {cancel = function() cancelled = true restore() end}
    conn = RunService.Heartbeat:Connect(function(dt)
        if cancelled or not mover.Parent then return restore() end
        local cf = pivotOf(mover)
        local delta = targetPos - cf.Position
        local dist = delta.Magnitude
        local step = speed * dt
        -- ล้างแรงเพื่อไม่ให้ฟิสิกส์ดึงกลับ
        for _, p in ipairs(mover:GetDescendants()) do
            if p:IsA("BasePart") then
                p.AssemblyLinearVelocity = Vector3.zero
                p.AssemblyAngularVelocity = Vector3.zero
            end
        end
        if dist <= step then
            mover:PivotTo(CFrame.new(targetPos) * (cf - cf.Position))
            restore(); currentTween = nil
            WindUI:Notify({Title="ถึงแล้ว", Content="Teleport สำเร็จ", Duration=2})
        else
            mover:PivotTo(cf + delta.Unit * step)
        end
    end)
end

-- ===== หาเป้าหมาย =====
local function raceTargets()
    local list = {}
    local ok, races = pcall(function() return RS:WaitForChild("RaceState",3):WaitForChild("Races",3) end)
    if not ok or not races then return list end
    for _, r in ipairs(races:GetChildren()) do
        local okj, cps = pcall(HttpService.JSONDecode, HttpService, r:GetAttribute("Checkpoints") or "[]")
        local c = okj and cps and cps[1]
        if c then
            table.insert(list, {
                name = (r:GetAttribute("Title") or r.Name),
                prize = r:GetAttribute("Prize") or 0,
                pos = Vector3.new(c[1], c[2] + heightOffset, c[3]),
            })
        end
    end
    table.sort(list, function(a,b) return a.prize > b.prize end)
    return list
end

local function partyDrop()
    local f = workspace:FindFirstChild("PartyDrops")
    if not f then return end
    for _, d in ipairs(f:GetChildren()) do
        if d:IsA("BasePart") and d:GetAttribute("C"..lp.UserId) ~= true then
            return d.Position + Vector3.new(0, 2, 0)
        end
    end
end

local function resolve(choice)
    if choice == "Party Drop (ของขวัญสายรุ้ง)" then
        local p = partyDrop()
        if p then return p, "Party Drop" end
        return nil, "ตอนนี้ไม่มี Party Drop"
    end
    local races = raceTargets()
    if choice == "Best Race (Prize สูงสุด)" then
        if races[1] then return races[1].pos, races[1].name.."  $"..races[1].prize end
        return nil, "ไม่พบ Race"
    end
    for _, r in ipairs(races) do
        if choice == r.name.."  $"..r.prize then return r.pos, r.name end
    end
    return nil, "ไม่พบเป้าหมาย"
end

local function buildOptions()
    local opts = {"Best Race (Prize สูงสุด)", "Party Drop (ของขวัญสายรุ้ง)"}
    for _, r in ipairs(raceTargets()) do table.insert(opts, r.name.."  $"..r.prize) end
    return opts
end

-- ===== UI =====
local Window = WindUI:CreateWindow({
    Title = "Bike Universe",
    Icon = "bike",
    Author = "Money Spot TP",
    Folder = "BikeUniverseTP",
})

local Tab = Window:Tab({Title = "Teleport", Icon = "map-pin"})

local dd = Tab:Dropdown({
    Title = "เลือกจุด",
    Values = buildOptions(),
    Value = selected,
    Callback = function(v) selected = v end,
})

Tab:Slider({
    Title = "ความเร็ว (studs/s)",
    Value = {Min = 20, Max = 1500, Default = speed},
    Step = 10,
    Callback = function(v) speed = v end,
})

Tab:Slider({
    Title = "ความสูงเหนือจุด",
    Value = {Min = 0, Max = 30, Default = heightOffset},
    Step = 1,
    Callback = function(v) heightOffset = v end,
})

Tab:Button({
    Title = "ไปเลย (Tween)",
    Callback = function()
        local pos, label = resolve(selected)
        if not pos then return WindUI:Notify({Title="ไม่พบจุด", Content=label, Duration=3}) end
        WindUI:Notify({Title="กำลังไป", Content=label, Duration=2})
        flyTo(pos)
    end,
})

Tab:Button({
    Title = "หยุด",
    Callback = stopTween,
})

Tab:Button({
    Title = "รีเฟรชรายการ",
    Callback = function()
        if dd.Refresh then dd:Refresh(buildOptions()) end
    end,
})
