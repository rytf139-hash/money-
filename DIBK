-- =========================
-- AUTODRIVE LOOP
-- =========================
RunService.Heartbeat:Connect(function()
    if not driving then
        return
    end

    local model, seat, chassis = getCurrentScooter()
    if not model or not seat or not chassis then
        stopDriving("ไม่พบรถหรือไม่ได้อยู่บนเบาะคนขับ")
        return
    end

    local target = waypoints[waypointIndex]
    if not target then
        stopDriving("ถึงจุดหมายครบแล้ว")
        return
    end

    local delta = Vector3.new(target.X - chassis.Position.X, 0, target.Z - chassis.Position.Z)
    local distance = delta.Magnitude
    local velocity = chassis.AssemblyLinearVelocity
    -- Match the game's own speed conversion: studs/s ÷ 3.571, then × 3.6 for km/h.
    local forwardSpeed = math.abs(velocity:Dot(chassis.CFrame.LookVector))
    lastActualSpeed = (forwardSpeed / 3.5714285714) * 3.6

    if distance <= ARRIVE_DISTANCE then
        waypointIndex += 1
        refreshRouteList()
        if waypointIndex > #waypoints then
            stopDriving("ถึงจุดหมายครบแล้ว")
            telemetryLabel.Text = string.format("ความเร็วจริง: %.0f km/h   •   จุด: เสร็จแล้ว", lastActualSpeed)
            return
        end
        target = waypoints[waypointIndex]
        delta = Vector3.new(target.X - chassis.Position.X, 0, target.Z - chassis.Position.Z)
        distance = delta.Magnitude
        setStatus("กำลังขับไปยังจุดที่ " .. waypointIndex, COLORS.green)
    end

    local steer, angle = steerToward(chassis, target)
    -- ใช้ค่าความเร็วที่ผู้ใช้ตั้งเป็นเป้าหมายโดยตรง
    -- ระบบฟิสิกส์ของรถยังอาจทำให้ความเร็วจริงต่ำกว่าค่านี้ได้
    local targetSpeed = desiredSpeedKmh
    local absAngle = math.abs(angle)
    if absAngle > math.rad(75) then
        targetSpeed = math.min(targetSpeed, 22)
    elseif absAngle > math.rad(42) then
        targetSpeed = math.min(targetSpeed, desiredSpeedKmh * 0.6)
    end
    if distance < 40 then
        targetSpeed = math.min(targetSpeed, math.max(10, distance * 1.2))
    end
    if distance < ARRIVE_DISTANCE * 2 then
        targetSpeed = math.min(targetSpeed, 12)
    end

    local throttle = getThrottleForSpeed(targetSpeed, lastActualSpeed)
    steer, throttle = (function()
        local adjustedSteer, adjustedThrottle = avoidObstacle(model, chassis, steer, throttle, lastActualSpeed, angle)
        return adjustedSteer, adjustedThrottle
    end)()

    -- Use original game's input layer rather than forcing the chassis CFrame.
    TouchControls.throttle = math.clamp(throttle, -1, 1)
    TouchControls.steer = math.clamp(steer, -1, 1)

    telemetryLabel.Text = string.format(
        "ความเร็วจริง: %.0f km/h   •   จุด: %d/%d",
        lastActualSpeed,
        waypointIndex,
        #waypoints
    )
end)

