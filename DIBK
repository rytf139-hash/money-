local function addCorner(instance, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 8)
    corner.Parent = instance
    return corner
end

local function addStroke(instance, color, transparency, thickness)
    local stroke = Instance.new("UIStroke")
    stroke.Color = color or Color3.fromRGB(76, 88, 110)
    stroke.Transparency = transparency or 0.3
    stroke.Thickness = thickness or 1
    stroke.Parent = instance
    return stroke
end

local function makeLabel(parent, name, text, position, size, textSize, color, xAlign)
    local label = Instance.new("TextLabel")
    label.Name = name
    label.BackgroundTransparency = 1
    label.Position = position
    label.Size = size
    label.Font = Enum.Font.GothamMedium
    label.Text = text
    label.TextSize = textSize or 13
    label.TextColor3 = color or COLORS.text
    label.TextXAlignment = xAlign or Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Center
    label.Parent = parent
    return label
end

