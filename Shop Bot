# ตรวจสอบและติดตั้งไลบรารีที่จำเป็นอัตโนมัติ
def install_if_missing(package: str, import_name: str = None):
    """
    ติดตั้ง package ถ้ายังไม่มีในระบบ
    package = ชื่อที่ใช้ pip install
    import_name = ชื่อที่ใช้ import (ถ้าต่างจาก package)
    """
    if import_name is None:
        import_name = package
    try:
        __import__(import_name)  # ลอง import ก่อน
    except ImportError:
        print(f"[SETUP] กำลังติดตั้ง {package}...")
        subprocess.check_call(
            [sys.executable, "-m", "pip", "install", package, "-q"],
            # -q = quiet mode (ไม่แสดง output มาก)
        )
        print(f"[SETUP] ✅ ติดตั้ง {package} สำเร็จ")

# ติดตั้งไลบรารีที่จำเป็นก่อนนำเข้า
install_if_missing("discord.py", "discord")
install_if_missing("python-dotenv", "dotenv")

