@bot.event
async def on_ready():
    """
    Event นี้จะถูกเรียกเมื่อบอทเชื่อมต่อ Discord สำเร็จ
    ใช้สำหรับ initialize ระบบต่างๆ
    """
    print(f"[BOT] ✅ บอทพร้อมใช้งาน: {bot.user.name}#{bot.user.discriminator}")
    print(f"[BOT] ID: {bot.user.id}")
    print(f"[BOT] Server ที่เข้าร่วม: {len(bot.guilds)} เซิร์ฟเวอร์")

    # สร้างฐานข้อมูลถ้ายังไม่มี
    db.init_db()

    # Sync slash commands กับ Discord
    # (ทำให้คำสั่ง / ปรากฏใน Discord)
    try:
        synced = await bot.tree.sync()
        print(f"[BOT] ✅ Sync slash commands สำเร็จ: {len(synced)} คำสั่ง")
    except Exception as e:
        print(f"[BOT] ❌ Sync slash commands ล้มเหลว: {e}")

    # ตั้งค่า Activity (สถานะที่แสดงใต้ชื่อบอท)
    await bot.change_presence(
        activity=discord.Activity(
            type=discord.ActivityType.watching,
            name="🛒 ร้านขายรหัสเกม | /shop"
        )
    )


@bot.event
async def on_command_error(ctx, error):
    """
    จัดการ error สำหรับ text commands (!)
    """
    if isinstance(error, commands.CommandNotFound):
        return  # ไม่ต้องแจ้งถ้าพิมพ์คำสั่งผิด
    print(f"[ERROR] {error}")


