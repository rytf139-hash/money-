        )
        return

    product = db.get_product(product_id)
    if not product:
        await interaction.response.send_message(
            embed=create_error_embed("ไม่พบสินค้า", f"ไม่มีสินค้า ID {product_id}"),
            ephemeral=True
        )
        return

    # ขอยืนยันก่อนลบ
    await interaction.response.send_message(
        embed=discord.Embed(
            title="⚠️ ยืนยันการลบสินค้า",
