@bot.tree.command(name="add-stock", description="[Admin] เพิ่มรหัสเกมเข้าสต็อก")
@app_commands.describe(
    product_id="ID ของสินค้า",
    codes="รหัสเกม (ถ้ามีหลายรหัส คั่นด้วย , หรือขึ้นบรรทัดใหม่)"
)
async def add_stock_command(interaction: discord.Interaction, product_id: int, codes: str):
    """
    /add-stock [product_id] [codes] - เพิ่มรหัสเกมเข้า stock
    รองรับหลาย code โดยคั่นด้วย comma (,)
    """
    if not is_owner(interaction.user.id):
        await interaction.response.send_message(
            embed=create_error_embed("ไม่มีสิทธิ์", "คำสั่งนี้สำหรับ Admin เท่านั้น"),
            ephemeral=True
        )
        return

    # ตรวจสอบว่าสินค้ามีอยู่จริง
    product = db.get_product(product_id)
    if not product:
        await interaction.response.send_message(
            embed=create_error_embed("ไม่พบสินค้า", f"ไม่มีสินค้า ID {product_id}"),
            ephemeral=True
        )
        return

    # แยก codes ออกจากกัน (รองรับทั้ง comma และ newline)
    code_list = [c.strip() for c in codes.replace("\n", ",").split(",") if c.strip()]

    if not code_list:
        await interaction.response.send_message(
            embed=create_error_embed("ไม่มีรหัส", "กรุณาใส่รหัสเกมอย่างน้อย 1 รหัส"),
            ephemeral=True
        )
        return

    # เพิ่ม code ทีละรหัส
    added_count = 0
    for code in code_list:
        db.add_stock(product_id, code)
        added_count += 1

    # นับ stock ทั้งหมดหลังเพิ่ม
    total_stock = db.get_stock_count(product_id)

    await interaction.response.send_message(
        embed=create_success_embed(
            "เพิ่มสต็อกสำเร็จ",
            f"เพิ่มรหัสเกมสำหรับ **{product['name']}** แล้ว\n\n"
            f"เพิ่มใหม่: **{added_count} รหัส**\n"
            f"สต็อกทั้งหมด: **{total_stock} รหัส**"
        ),
        ephemeral=True
    )


@bot.tree.command(name="delete-product", description="[Admin] ลบสินค้าออกจากระบบ")
@app_commands.describe(product_id="ID ของสินค้าที่ต้องการลบ")
async def delete_product_command(interaction: discord.Interaction, product_id: int):
    """
    /delete-product [product_id] - ลบสินค้าและ stock ทั้งหมด
    """
    if not is_owner(interaction.user.id):
        await interaction.response.send_message(
