# ==================== ฟังก์ชันช่วยเหลือ ====================

def is_owner(user_id: int) -> bool:
    """ตรวจสอบว่าเป็น Owner หรือไม่"""
    return user_id == OWNER_ID


async def send_backend_notification(message: str, embed: discord.Embed = None):
    """
    ส่งข้อความแจ้งเตือนไปยัง Backend Channel
    ใช้สำหรับแจ้ง admin เมื่อมีธุรกรรมเกิดขึ้น
    """
    channel_id = config.get("backend_channel_id", 0)
    if not channel_id:
        return  # ถ้ายังไม่ได้ตั้งค่า channel ให้ข้ามไป

    channel = bot.get_channel(int(channel_id))
    if channel:
        try:
            if embed:
                await channel.send(message, embed=embed)
            else:
                await channel.send(message)
        except discord.Forbidden:
            print(f"[ERROR] บอทไม่มีสิทธิ์ส่งข้อความในช่อง {channel_id}")


def create_error_embed(title: str, description: str) -> discord.Embed:
    """สร้าง Embed สำหรับแสดงข้อผิดพลาด (สีแดง)"""
    embed = discord.Embed(
        title=f"❌ {title}",
        description=description,
        color=discord.Color.red()  # สีแดง
    )
    return embed


def create_success_embed(title: str, description: str) -> discord.Embed:
    """สร้าง Embed สำหรับแสดงความสำเร็จ (สีเขียว)"""
    embed = discord.Embed(
        title=f"✅ {title}",
        description=description,
        color=discord.Color.green()  # สีเขียว
    )
    return embed


def create_info_embed(title: str, description: str) -> discord.Embed:
    """สร้าง Embed สำหรับแสดงข้อมูลทั่วไป (สีน้ำเงิน)"""
    embed = discord.Embed(
        title=f"ℹ️ {title}",
        description=description,
        color=discord.Color.blue()  # สีน้ำเงิน
    )
    return embed


