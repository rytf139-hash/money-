@bot.tree.command(name="buy", description="ซื้อสินค้าด้วย ID สินค้า")
@app_commands.describe(product_id="ID ของสินค้าที่ต้องการซื้อ (ดูได้จาก /shop)")
async def buy_command(interaction: discord.Interaction, product_id: int):
    """
    /buy [product_id] - ซื้อสินค้าและรับรหัสเกมทาง DM
    """
    user_id = str(interaction.user.id)

    # ตรวจสอบว่าสินค้ามีอยู่จริง
    product = db.get_product(product_id)
    if not product:
        await interaction.response.send_message(
            embed=create_error_embed("ไม่พบสินค้า", f"ไม่มีสินค้า ID {product_id} ในระบบ"),
            ephemeral=True
        )
        return

    # ตรวจสอบ stock
    stock = db.get_available_stock(product_id)
    if not stock:
        await interaction.response.send_message(
            embed=create_error_embed(
                "สินค้าหมดสต็อก",
                f"สินค้า **{product['name']}** หมดสต็อกแล้ว กรุณารอสินค้าเพิ่มเติม"
            ),
            ephemeral=True
        )
        return

    # ตรวจสอบยอดเงิน
    balance = db.get_balance(user_id)
    price = product["price"]

    if balance < price:
        shortage = price - balance  # เงินที่ขาด
        await interaction.response.send_message(
            embed=create_error_embed(
                "ยอดเงินไม่เพียงพอ",
                f"ราคาสินค้า: **{price:,.2f} บาท**\n"
                f"ยอดเงินของคุณ: **{balance:,.2f} บาท**\n"
                f"ขาดอีก: **{shortage:,.2f} บาท**\n\n"
                f"กรุณาติดต่อแอดมินเพื่อเติมเงินครับ"
            ),
            ephemeral=True
        )
        return

    # ทุกอย่างผ่าน: ทำการซื้อ
    # 1. หักเงินจากบัญชี
    new_balance = db.update_balance(user_id, -price)

    # 2. ทำเครื่องหมาย stock ว่าถูกขายแล้ว
    db.mark_stock_used(stock["id"], user_id)

    # 3. บันทึกธุรกรรม
    db.add_transaction(
        user_id,
        "purchase",
        price,
        f"ซื้อ {product['name']} (Stock ID: {stock['id']})"
    )

    # 4. ส่งรหัสเกมทาง DM (Direct Message)
    try:
        dm_embed = discord.Embed(
            title="🎮 รหัสเกมของคุณ",
            description=f"ขอบคุณที่ซื้อสินค้ากับเรา!",
            color=discord.Color.green()
        )
        dm_embed.add_field(name="สินค้า", value=product["name"], inline=True)
        dm_embed.add_field(name="ราคา", value=f"{price:,.2f} บาท", inline=True)
        dm_embed.add_field(
            name="🔑 รหัสเกม (Code)",
            value=f"```\n{stock['code']}\n```",  # แสดงใน code block
            inline=False
        )
        dm_embed.add_field(
            name="ยอดเงินคงเหลือ",
            value=f"{new_balance:,.2f} บาท",
            inline=False
        )
        dm_embed.set_footer(text="หากมีปัญหา กรุณาติดต่อ Admin")

        await interaction.user.send(embed=dm_embed)  # ส่ง DM
        dm_sent = True
    except discord.Forbidden:
        # ผู้ใช้ปิด DM ไม่ให้รับข้อความ
        dm_sent = False

    # 5. แจ้งผลการซื้อในช่องที่พิมพ์คำสั่ง
    if dm_sent:
        result_embed = create_success_embed(
            "ซื้อสินค้าสำเร็จ!",
            f"ซื้อ **{product['name']}** สำเร็จแล้ว!\n"
            f"รหัสเกมถูกส่งไปยัง DM ของคุณแล้ว 📩\n"
            f"ยอดเงินคงเหลือ: **{new_balance:,.2f} บาท**"
        )
    else:
        result_embed = discord.Embed(
            title="✅ ซื้อสำเร็จ แต่ส่ง DM ไม่ได้",
            description=(
                f"ซื้อ **{product['name']}** สำเร็จ แต่ไม่สามารถส่ง DM ได้\n"
                f"กรุณาเปิดการรับ DM แล้วติดต่อ Admin เพื่อรับรหัส\n"
                f"ยอดเงินคงเหลือ: **{new_balance:,.2f} บาท**"
            ),
            color=discord.Color.orange()
        )

    await interaction.response.send_message(embed=result_embed, ephemeral=True)

    # 6. แจ้ง Admin ใน Backend Channel
    admin_embed = discord.Embed(
        title="🛒 มีการซื้อสินค้า",
        color=discord.Color.blue()
    )
    admin_embed.add_field(name="ผู้ซื้อ", value=f"{interaction.user.mention} ({user_id})", inline=False)
    admin_embed.add_field(name="สินค้า", value=product["name"], inline=True)
    admin_embed.add_field(name="ราคา", value=f"{price:,.2f} บาท", inline=True)
    admin_embed.add_field(name="Stock ID", value=str(stock["id"]), inline=True)
    admin_embed.add_field(name="ยอดเงินหลังซื้อ", value=f"{new_balance:,.2f} บาท", inline=True)

    await send_backend_notification("", embed=admin_embed)



