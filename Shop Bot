# คลาสสำหรับปุ่มกดซื้อสินค้า
class ShopButtons(discord.ui.View):
    def __init__(self, products):
        super().__init__(timeout=None)  # ปุ่มจะไม่หมดอายุ
        for p in products:
            # สร้างปุ่มสำหรับสินค้าแต่ละชิ้น
            button = discord.ui.Button(
                label=f"ซื้อ {p['name']} ({p['price']:,.0f} บาท)",
                style=discord.ButtonStyle.success,
                custom_id=f"buy_btn_{p['id']}"
            )
            button.callback = self.create_callback(p['id'])
            self.add_item(button)

    def create_callback(self, product_id):
        async def callback(interaction: discord.Interaction):
            # เมื่อลูกค้ากดปุ่ม จะส่งข้อความบอกวิธีซื้อให้เขาเห็นคนเดียว
            await interaction.response.send_message(
                f"🛒 คุณต้องการซื้อสินค้า ID: **{product_id}**\n"
                f"กรุณาพิมพ์คำสั่ง: `/buy product_id:{product_id}` เพื่อทำการสั่งซื้อครับ",
                ephemeral=True
            )
        return callback


@bot.tree.command(name="shop", description="[Admin Only] ส่งรายการสินค้าลงในช่องแชท")
@app_commands.checks.has_permissions(administrator=True)  # จำกัดให้เฉพาะ Admin เท่านั้นที่ใช้ได้
async def shop_command(interaction: discord.Interaction):
    """
    /shop - Admin ใช้ส่งหน้าร้านพร้อมปุ่มกดซื้อลงในช่องแชท
    """
    products = db.get_all_products()  # ดึงสินค้าทั้งหมด

    if not products:
        await interaction.response.send_message(
            embed=create_info_embed("ร้านค้า", "ยังไม่มีสินค้าในร้านค้าขณะนี้"),
            ephemeral=True
        )
        return

    # สร้าง Embed สำหรับแสดงรายการสินค้า
    embed = discord.Embed(
        title="✨ ยินดีต้อนรับสู่ร้านค้าของเรา ✨",
        description="เลือกสินค้าที่ต้องการด้านล่างนี้ได้เลยครับ\nเมื่อกดปุ่ม บอทจะบอกวิธีซื้อให้คุณทราบ",
        color=discord.Color.gold()
    )

    for product in products:
        stock_count = db.get_stock_count(product["id"])  # นับ stock ที่เหลือ

        # แสดงสถานะ stock
        if stock_count == 0:
            stock_status = "❌ หมดสต็อก"
        elif stock_count <= 3:
            stock_status = f"⚠️ เหลือน้อย ({stock_count} ชิ้น)"
        else:
            stock_status = f"✅ มีสินค้า ({stock_count} ชิ้น)"

        embed.add_field(
            name=f"📦 {product['name']} (ID: {product['id']})",
            value=(
                f"**ราคา:** {product['price']:,.2f} บาท\n"
                f"**รายละเอียด:** {product['description'] or 'ไม่มีคำอธิบาย'}\n"
                f"**สถานะ:** {stock_status}"
            ),
            inline=False
        )

    # ส่ง Embed พร้อมปุ่มกด (ทุกคนในช่องเห็นได้)
    view = ShopButtons(products)
    await interaction.response.send_message(embed=embed, view=view)


