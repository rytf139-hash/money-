end

-- ── สแกนหาแลนด์มาร์กในแมพ (ใช้ทำปุ่มวาร์ป) ──────────────────
local LandmarkKeys = {
	"well", "market", "shop", "sell", "scale", "garage", "fish", "pond", "spawn",
	"rebirth", "barn", "warehouse", "dock", "npc", "quest", "mine", "quest", "port",
}
function World.scanLandmarks(limit)
	limit = limit or 60
	local found, seen = {}, {}
	local map = Workspace:FindFirstChild("Map") or Workspace
	local count = 0
	for _, d in ipairs(map:GetDescendants()) do
		count = count + 1
		if count > 40000 then break end
		if d:IsA("BasePart") or d:IsA("Model") then
			local n = string.lower(d.Name)
			for _, key in ipairs(LandmarkKeys) do
				if n:find(key, 1, true) then
					local pos = nil
					if d:IsA("Model") then
						local ok, pivot = pcall(function() return d:GetPivot() end)
						pos = ok and pivot.Position or nil
					else
						if d.Size.Magnitude > 1 and d.Transparency < 1 then pos = d.Position end
					end
					if pos and not seen[d.Name .. math.floor(pos.X) .. math.floor(pos.Z)] then
						seen[d.Name .. math.floor(pos.X) .. math.floor(pos.Z)] = true
						table.insert(found, { name = d.Name, pos = pos, inst = d })
					end
					break
				end
			end
		end
		if #found >= limit then break end
	end
	table.sort(found, function(a, b)
		local pa, pb = World.pos(), World.pos()
		local da = pa and (a.pos - pa).Magnitude or 0
		local db = pb and (b.pos - pb).Magnitude or 0
		return da < db
	end)
	return found
end

function World.spawnPoint()
	local sp = Workspace:FindFirstChildOfClass("SpawnLocation")
	if sp then return sp.Position + Vector3.new(0, 4, 0) end
	local map = Workspace:FindFirstChild("Map")
	if map then
		local s = map:FindFirstChild("Spawn", true)
		if s and s:IsA("BasePart") then return s.Position + Vector3.new(0, 4, 0) end
	end
	return nil
end

