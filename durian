		TextSize = 13, Font = Enum.Font.GothamSemiBold, TextXAlignment = Enum.TextXAlignment.Left,
	}, row)
	local value = new("TextLabel", {
		Size = UDim2.fromOffset(78, 20), Position = UDim2.new(1, -88, 0, 8), BackgroundTransparency = 1,
		Text = "", TextColor3 = HUB.Accent, TextSize = 13, Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Right,
	}, row)
	UI.registerAccent(value, "text")

	local hit = new("TextButton", {
		Size = UDim2.new(1, -28, 0, 26), Position = UDim2.new(0, 14, 1, -32),
		BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Active = true, ZIndex = 3,
	}, row)
	local trackFrame = new("Frame", {
		Size = UDim2.new(1, 0, 0, 7), Position = UDim2.new(0, 0, 0.5, -3),
		BackgroundColor3 = Theme.track, BorderSizePixel = 0, ZIndex = 3,
	}, hit)
	corner(4, trackFrame)
	local fill = new("Frame", {
		Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = HUB.Accent, BorderSizePixel = 0, ZIndex = 4,
	}, trackFrame)
	corner(4, fill)
	UI.registerAccent(fill)
	local knob = new("Frame", {
		Size = UDim2.fromOffset(18, 18), Position = UDim2.new(0, -9, 0.5, -9),
		BackgroundColor3 = Color3.fromRGB(245, 245, 248), BorderSizePixel = 0, ZIndex = 5,
	}, fill)
	corner(9, knob)
	stroke(HUB.Accent, 2, 0.15, knob)

	local knobScale = new("UIScale", { Scale = 1 }, knob)
	local obj = { row = row, value = opts.default or min, onChange = opts.callback }
	local function fmt(v)
		local s = string.format("%." .. dec .. "f", v)
		return s .. (opts.suffix or "")
	end
	function obj:Set(v, silent)
		v = clamp(tonumber(v) or min, min, max)
		obj.value = v
		local ratio = (max > min) and (v - min) / (max - min) or 0
		HUB.Tween(fill, 0.14, { Size = UDim2.new(ratio, 0, 1, 0) })
		knob.Position = UDim2.new(ratio, -9, 0.5, -9)
		value.Text = fmt(v)
		if not silent and obj.onChange then pcall(obj.onChange, v) end
	end
	local function fromInput(input)
		local x = input.Position.X
		local p = trackFrame.AbsolutePosition.X
		local s = math.max(trackFrame.AbsoluteSize.X, 1)
		obj:Set(min + clamp((x - p) / s, 0, 1) * (max - min))
	end
	local dragging = false
	track(hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			HUB.Tween(knobScale, 0.14, { Scale = 1.25 }, Enum.EasingStyle.Back)
			fromInput(input)
		end
	end))
	track(hit.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then fromInput(input) end
	end))
	track(hit.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
			HUB.Tween(knobScale, 0.2, { Scale = 1 }, Enum.EasingStyle.Back)
		end
	end))
	obj:Set(obj.value, true)
	table.insert(page.widgets, obj)
	return obj
end

