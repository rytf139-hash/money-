-- fallback สำหรับ executor ที่ไม่มี math.clamp / table.find
local clamp = math.clamp or function(v, lo, hi)
	if v ~= v then return lo end
	if v < lo then return lo elseif v > hi then return hi end
	return v
end
local function tFind(list, value)
	if table.find then return table.find(list, value) end
	for i = 1, #list do if list[i] == value then return i end end
	return nil
end

-- ตรวจจับแพลตฟอร์ม (สไตล์ UIPlatform ของเกม)
local function detectPlatform()
	local ok, inset = pcall(function() return GuiService:IsTenFootInterface() end)
	if ok and inset then return "Console" end
	if UserInputService.TouchEnabled then
		local vp = (camera and camera.ViewportSize) or Vector2.new(1366, 768)
		if math.min(vp.X, vp.Y) < 600 then return "Phone" end
		if not UserInputService.MouseEnabled then return "Tablet" end
	end
	return "PC"
end
HUB.Platform = detectPlatform()
HUB.IsTouch  = (HUB.Platform == "Phone" or HUB.Platform == "Tablet")

