	return new(dir == "H" and "UIListLayout" or "UIListLayout", {
		FillDirection = dir == "H" and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, spacing or 6),
	}, parent)
end
local function gradient(c1, c2, rot, parent)
	return new("UIGradient", { Color = ColorSequence.new(c1, c2), Rotation = rot or 90 }, parent)
end

function UI.registerAccent(obj, kind)
	if kind == "text" then table.insert(UI.AccentText, obj) else table.insert(UI.AccentBg, obj) end
end

function UI.setAccent(accentId)
	local found = Accents[1]
	for _, a in ipairs(Accents) do if a.id == accentId then found = a end end
	HUB.Accent, HUB.AccentDk = found.color, found.dark
	State.ui.accent = found.id
	for _, o in ipairs(UI.AccentBg) do
		if o and o.Parent then
			pcall(function() HUB.Tween(o, 0.22, { BackgroundColor3 = HUB.Accent }) end)
			local g = o:FindFirstChildOfClass("UIGradient")
			if g then pcall(function() g.Color = ColorSequence.new(HUB.Accent, HUB.AccentDk) end) end
			for _, c in ipairs(o:GetChildren()) do
				if c:IsA("UIStroke") and c.Color ~= Theme.ink then pcall(function() HUB.Tween(c, 0.22, { Color = HUB.Accent }) end) end
			end
		end
	end
	for _, o in ipairs(UI.AccentText) do
		if o and o.Parent then pcall(function() HUB.Tween(o, 0.22, { TextColor3 = HUB.Accent }) end) end
	end
	if UI.Indicator and UI.Indicator.Parent then
		HUB.Tween(UI.Indicator, 0.25, { BackgroundColor3 = HUB.Accent })
	end
	if UI.Launcher then
		for _, d in ipairs(UI.Launcher:GetChildren()) do
			if d:IsA("UIGradient") then pcall(function() d.Color = ColorSequence.new(HUB.Accent, HUB.AccentDk) end) end
		end
	end
end

-- ── ขนาดหน้าต่างตามจอ (มือถือ/แท็บเล็ต/PC) ────────────────────
function UI.windowSize()
	camera = Workspace.CurrentCamera or camera
	local vp = (camera and camera.ViewportSize) or Vector2.new(1366, 768)
	local inset = select(2, pcall(function() return GuiService:GetGuiInset() end))
	local topInset = (type(inset) == "Vector2" and inset.Y) or 0
	local sc = (UI.GuiScale and UI.GuiScale.Scale) or 1
	local w = math.min(HUB.IsTouch and 460 or 430, (vp.X * 0.95) / sc)
	local h = math.min(HUB.IsTouch and 620 or 560, (vp.Y * 0.92) / sc)
	return w, h, topInset
end

-- จัดหน้าต่างกึ่งกลางจอ (คิด UIScale + safe area ให้แล้ว)
function UI.centerWindow()
	if not (UI.Window and UI.Window.Parent) then return end
	camera = Workspace.CurrentCamera or camera
	local vp = (camera and camera.ViewportSize) or Vector2.new(1366, 768)
	local inset = select(2, pcall(function() return GuiService:GetGuiInset() end))
	local topInset = (type(inset) == "Vector2" and inset.Y) or 0
	local sc = (UI.GuiScale and UI.GuiScale.Scale) or 1
	local w, h = UI.windowSize()
	UI.Window.Size = UDim2.fromOffset(w, h)
	UI.Window.Position = UDim2.fromOffset(
		math.max(4 / sc, (vp.X / sc - w) / 2),
		math.max((topInset + 6) / sc, (vp.Y / sc - h) / 2)
	)
end

