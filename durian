local ESP = {}
HUB.ESP = ESP
ESP.holder = nil
ESP.items = {}   -- [kind] = { [instance] = {hl=, bb=, label=} }

local EspStyle = {
	fruit   = { color = Color3.fromRGB(255, 225, 90),  name = "ผลสุก",   icon = "🍈" },
	plot    = { color = Color3.fromRGB(95, 225, 45),   name = "แปลงปลูก", icon = "🌱" },
	npc     = { color = Color3.fromRGB(120, 200, 255), name = "NPC",     icon = "🧑‍🌾" },
	vehicle = { color = Color3.fromRGB(255, 170, 80),  name = "รถ",      icon = "🚚" },
	player  = { color = Color3.fromRGB(255, 90, 120),  name = "ผู้เล่น",  icon = "👤" },
	chest   = { color = Color3.fromRGB(200, 140, 255), name = "หีบ/คลัง", icon = "📦" },
	pond    = { color = Color3.fromRGB(80, 190, 255),  name = "บ่อปลา",   icon = "🎣" },
}

function ESP.ensureHolder()
	if ESP.holder and ESP.holder.Parent then return ESP.holder end
	ESP.holder = new("Folder", { Name = "HubESP" }, Workspace)
	return ESP.holder
end

function ESP.add(kind, inst, part, text)
	if not (inst and inst.Parent) then return end
	ESP.items[kind] = ESP.items[kind] or {}
	if ESP.items[kind][inst] then return end
	local style = EspStyle[kind] or EspStyle.fruit
	local holder = ESP.ensureHolder()
	local adornee = part or inst
	if not (adornee and adornee:IsA("BasePart")) then
		adornee = (inst:IsA("Model") and inst:FindFirstChildWhichIsA("BasePart", true)) or adornee
	end
	local hlAdornee = inst
	local hl = new("Highlight", {
		Adornee = hlAdornee, FillColor = style.color, OutlineColor = Color3.new(1, 1, 1),
		FillTransparency = 0.72, OutlineTransparency = 0.15,
		DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Parent = holder,
	})
	local bb = new("BillboardGui", {
		Adornee = adornee, Size = UDim2.fromOffset(220, 40), StudsOffsetWorldSpace = Vector3.new(0, 2.4, 0),
		AlwaysOnTop = true, BackgroundTransparency = 1, Parent = holder,
	})
	local lbl = new("TextLabel", {
		Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Theme.ink, BackgroundTransparency = 0.25,
		Text = text or style.name, TextColor3 = style.color, TextSize = 13,
		Font = Enum.Font.GothamBold, RichText = true, TextWrapped = false, Parent = bb,
	})
	new("UICorner", { CornerRadius = UDim.new(0, 8) }, lbl)
	new("UIStroke", { Color = style.color, Thickness = 1, Transparency = 0.4 }, lbl)
	ESP.items[kind][inst] = { hl = hl, bb = bb, label = lbl, baseText = text or style.name, adornee = adornee }
end

function ESP.remove(kind, inst)
	local set = ESP.items[kind]
	if not (set and set[inst]) then return end
	local rec = set[inst]
	if rec.hl then rec.hl:Destroy() end
	if rec.bb then rec.bb:Destroy() end
	set[inst] = nil
end

function ESP.clear(kind)
	local set = ESP.items[kind]
	if not set then return end
	for inst in pairs(set) do ESP.remove(kind, inst) end
	ESP.items[kind] = {}
end

function ESP.clearAll()
	for kind in pairs(EspStyle) do ESP.clear(kind) end
end

function ESP.collect(kind)
	local out = {}
	if kind == "fruit" then
		for _, fruit in ipairs(CollectionService:GetTagged("DurianFruit")) do
			local prompt, part = World.ripePromptOf(fruit)
			if prompt then
				local mine = World.isMine(fruit)
				table.insert(out, { inst = fruit, part = part, text = "🍈 ทุเรียนสุก" .. (mine and " (ของเรา)" or " (คนอื่น)") })
			end
		end
	elseif kind == "plot" then
		for _, s in ipairs(World.plantSpots(State.farm.onlyMine, 1e9)) do
			table.insert(out, { inst = s.parent or s.spot, part = s.spot, text = "🌱 แปลงปลูก" })
		end
	elseif kind == "npc" then
		for _, n in ipairs(CollectionService:GetTagged("TalkNPC")) do
			table.insert(out, { inst = n, text = "🧑‍🌾 NPC" })
		end
	elseif kind == "chest" then
		for _, c in ipairs(CollectionService:GetTagged("StorageChest")) do
			table.insert(out, { inst = c, text = "📦 คลังเก็บของ" })
		end
	elseif kind == "vehicle" then
		local map = Workspace:FindFirstChild("Map") or Workspace
		for _, d in ipairs(map:GetChildren()) do
			if d:IsA("Model") and d:GetAttribute("VehicleId") then
				table.insert(out, { inst = d, text = "🚚 " .. tostring(d:GetAttribute("VehicleId")) })
			end
		end
	elseif kind == "player" then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player and p.Character then
				local hrp = p.Character:FindFirstChild("HumanoidRootPart")
				table.insert(out, { inst = p.Character, part = hrp, text = "👤 " .. p.Name })
			end
		end
	elseif kind == "pond" then
		local pc, pr = World.pond()
		if pc then table.insert(out, { inst = player, part = nil, text = "🎣 บ่อปลา (r=" .. math.floor(pr or 0) .. ")", pos = pc }) end
	end
	return out
end

function ESP.refresh()
	for kind in pairs(EspStyle) do
		if State.esp[kind] then
			local seen = {}
			local list = ESP.collect(kind)
			for _, e in ipairs(list) do
				if e.inst and e.inst.Parent then
					seen[e.inst] = true
					if kind == "pond" and e.pos then
						if not ESP.pondMarker or not ESP.pondMarker.Parent then
							ESP.pondMarker = new("Part", {
								Name = "HubPondMarker", Anchored = true, CanCollide = false, CanQuery = false,
								CanTouch = false, Transparency = 1, Size = Vector3.new(4, 1, 4), Parent = ESP.ensureHolder(),
							})
						end
						ESP.pondMarker.CFrame = CFrame.new(e.pos)
						ESP.add(kind, player, ESP.pondMarker, e.text)
					else
						local part = e.part
						if not part and e.inst:IsA("Model") then
							part = e.inst:FindFirstChildWhichIsA("BasePart", true)
						end
						ESP.add(kind, e.inst, part or e.inst, e.text)
					end
				end
			end
			local set = ESP.items[kind]
			if set then
				for inst in pairs(set) do
					if not seen[inst] or not inst.Parent then ESP.remove(kind, inst) end
				end
			end
		else
			ESP.clear(kind)
		end
	end
end

-- ESP ผู้เล่น (ติดตามตอนเกิดใหม่)
function ESP.watchPlayers()
	local function hookChar(p)
		if p == player then return end
		local function onChar(char)
			task.wait(0.6)
			if State.esp.player and char and char.Parent then
				local hrp = char:FindFirstChild("HumanoidRootPart")
				ESP.add("player", char, hrp or char, "👤 " .. p.Name)
			end
		end
		if p.Character then onChar(p.Character) end
		track(p.CharacterAdded:Connect(onChar))
	end
	for _, p in ipairs(Players:GetPlayers()) do hookChar(p) end
	track(Players.PlayerAdded:Connect(hookChar))
end

function ESP.loop()
	task.spawn(function()
		while HUB.Alive do
			pcall(ESP.refresh)
			task.wait(1.6)
		end
	end)
	-- อัปเดตระยะทาง 6 ครั้ง/วินาที
	task.spawn(function()
		while HUB.Alive and task.wait(0.16) do
			if State.esp.distance then
