function UI.selectTab(id)
	local target = UI.Tabs[id]
	if not target then return end
	UI.CurrentTab = id
	for _, p in ipairs(UI.Pages) do
		local isTarget = (p.id == id)
		if isTarget then
			p.page.Visible = true
			p.page.CanvasPosition = Vector2.new(0, 0)
			p.page.Position = UDim2.new(0, 26, 0, 0)
			p.page.BackgroundTransparency = 1
			HUB.Tween(p.page, 0.22, { Position = UDim2.new(0, 0, 0, 0) }, Enum.EasingStyle.Quint)
			p.btn.BackgroundTransparency = 0
			p.btn.BackgroundColor3 = HUB.Accent
			p.btn.TextColor3 = Color3.new(1, 1, 1)
		else
			p.page.Visible = false
			p.btn.BackgroundTransparency = 0.55
			p.btn.BackgroundColor3 = Theme.row
			p.btn.TextColor3 = Theme.muted
		end
	end
	-- เลื่อน indicator ไปใต้แท็บ
	task.defer(function()
		if not (UI.Indicator and target.btn.Parent) then return end
		UI.Indicator.Visible = true
		local scale = (UI.GuiScale and UI.GuiScale.Scale) or 1
		local rel = (target.btn.AbsolutePosition.X - UI.TabScroller.AbsolutePosition.X) / scale
		local viewW = UI.TabScroller.AbsoluteSize.X / scale
		local cp = UI.TabScroller.CanvasPosition.X
		if rel < cp + 10 or rel + 90 > cp + viewW then
			UI.TabScroller.CanvasPosition = Vector2.new(math.max(0, rel - 40), 0)
			rel = (target.btn.AbsolutePosition.X - UI.TabScroller.AbsolutePosition.X) / scale
		end
		HUB.Tween(UI.Indicator, 0.26, {
			Position = UDim2.new(0, rel, 1, -4),
			Size = UDim2.fromOffset(math.max(28, target.btn.AbsoluteSize.X), 3),
		}, Enum.EasingStyle.Back)
	end)
	if UI.OnTabChange then pcall(UI.OnTabChange, id) end
end

