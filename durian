local Fish = {}
HUB.Fish = Fish
Fish.lastCast = 0
Fish.caught = 0

function Fish.castTarget(depth)
	depth = depth or 0
	local pc, pr = World.pond()
	if not pc then return nil, "noPond" end
	local hrp = World.hrp()
	if not hrp then return nil, "noChar" end
	local cfg = HUB.Config("FishingConfig")
	local castRange = (cfg and cfg.CastRange) or 36
	local from = hrp.Position
	local flat = Vector3.new(pc.X - from.X, 0, pc.Z - from.Z)
	local dist = flat.Magnitude
	if dist > castRange * 0.9 and State.fish.tpToPond and depth < 1 then
		local dir = dist > 0.5 and flat.Unit or Vector3.new(1, 0, 0)
		local stand = pc - dir * math.max(6, pr * 0.55)
		World.teleportTo(Vector3.new(stand.X, from.Y, stand.Z), 3)
		task.wait(0.2)
		return Fish.castTarget(depth + 1)
	end
	if dist > castRange then return nil, "tooFar" end
	local step = math.min(dist, castRange * 0.8)
	local p = (dist > 0.5) and (from + flat.Unit * step) or (from + Vector3.new(step, 0, 0))
	local off = Vector3.new(p.X - pc.X, 0, p.Z - pc.Z)
	if off.Magnitude > math.max(pr - 3, 1) then p = pc + off.Unit * math.max(pr - 3, 1) end
	return Vector3.new(p.X, 0, p.Z)
end

function Fish.cast()
	local rod = World.toolByGear("Rod")
	if not rod then UI.setStatus("⚠️ ไม่พบเบ็ดตกปลาในกระเป๋า", "#ffd45e") return false end
	World.equip(rod)
	if rod:GetAttribute("FishState") then return false end
	if not player:GetAttribute("OwnPond") then
		UI.setStatus("⚠️ ยังไม่มีบ่อปลา (ซื้อ Fishing Pond หลังสวน)", "#ffd45e")
		return false
	end
	local bait = State.fish.baitAuto and World.pickBait() or State.fish.bait
	if not bait or World.baitCount(bait) <= 0 then
		UI.setStatus("⚠️ เหยื่อหมด! ซื้อที่ร้านขายปลา", "#ff9c9c")
		return false
	end
	local cap = tonumber(player:GetAttribute("FishCap")) or 0
	local cnt = tonumber(player:GetAttribute("FishCount")) or 0
	if cap > 0 and cnt >= cap then
		UI.setStatus("🎣 ถังปลาเต็ม (" .. cnt .. "/" .. cap .. ") ไปขายก่อน", "#ffd45e")
		return false
	end
	local target, err = Fish.castTarget()
	if not target then
		if err == "tooFar" then UI.setStatus("⚠️ อยู่ห่างบ่อปลาเกินไป", "#ffd45e") end
		return false
	end
	local hrp = World.hrp()
	if hrp then
		pcall(function() hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(target.X, hrp.Position.Y, target.Z)) end)
	end
	task.wait(0.08)
	if HUB.Fire("Fishing", "Cast", target, bait) then
		Fish.lastCast = os.clock()
		UI.setStatus("🎣 หย่อนเบ็ดแล้ว (เหยื่อ " .. tostring(bait) .. ")", "#7fd4ff")
		return true
	end
	return false
end

function Fish.loop()
	task.spawn(function()
		while HUB.Alive and task.wait(0.08) do
			if State.fish.auto then
				pcall(function()
					local rod = World.toolByGear("Rod")
					if rod then
						local st = rod:GetAttribute("FishState")
						if st == "Bite" and State.fish.autoHook then
							HUB.Fire("Fishing", "Hook")
							UI.setStatus("🐟 ปลาติดเบ็ด! วัดเบ็ดแล้ว", "#9be86a")
							Fish.lastCast = os.clock()
						elseif st == "Reel" and State.fish.autoReel then
							task.wait(State.fish.reelWait)
							if rod.Parent and rod:GetAttribute("FishState") == "Reel" then
								HUB.Fire("Fishing", "Reel", true)
								Fish.caught = Fish.caught + 1
								UI.setStatus("🎣 ตกได้! (รวม " .. Fish.caught .. " ตัว)", "#9be86a")
								HUB.Notify("ตกปลาสำเร็จ ตัวที่ " .. Fish.caught, "ok")
							end
						elseif (not st) and State.fish.autoCast and (os.clock() - Fish.lastCast) > State.fish.castDelay then
							Fish.cast()
						end
					end
				end)
			end
		end
	end)
end

