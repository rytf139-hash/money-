local function corner(radius, parent) return new("UICorner", { CornerRadius = UDim.new(0, radius or 10) }, parent) end
local function stroke(color, thickness, transp, parent)
	return new("UIStroke", { Color = color or Theme.ink, Thickness = thickness or 1, Transparency = transp or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, parent)
end
local function pad(t, b, l, r, parent)
	return new("UIPadding", {
		PaddingTop = UDim.new(0, t or 0), PaddingBottom = UDim.new(0, b or 0),
		PaddingLeft = UDim.new(0, l or 0), PaddingRight = UDim.new(0, r or 0),
