local Farm = {}
HUB.Farm = Farm
Farm.lastRebirthTry = 0
Farm.stats = { harvested = 0, watered = 0, sold = 0, rebirths = 0, fish = 0 }

function UI.setStatus(text, color)
	if UI.Footer and UI.Footer.Parent then
		UI.Footer.Text = '<font color="' .. (color or "#c8c8d2") .. '">' .. tostring(text) .. "</font>"
	end
