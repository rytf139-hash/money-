			HUB.Tween(arrow, 0.16, { Rotation = 0 })
			task.delay(0.18, function() if not obj.open then listBox.Visible = false end end)
		end
	end))
	val.Text = tostring(obj.value or "")
	table.insert(page.widgets, obj)
	return obj
end

