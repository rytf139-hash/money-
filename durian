-- ── เก็บเกี่ยว ──
function Farm.harvestOnce(limit)
	limit = limit or 999
	local targets = World.harvestTargets(State.farm.onlyMine, State.farm.reachDist)
	if #targets == 0 then return 0 end
	table.sort(targets, function(a, b) return a.dist < b.dist end)
	local rem = HUB.Remote("HarvestFruit")
	local hasFirePrompt = (typeof(fireproximityprompt) == "function")
	local count = 0
	for i = 1, math.min(limit, #targets) do
		if not HUB.Alive then break end
		local t = targets[i]
		if t.prompt and t.prompt.Parent then
			if State.farm.tpToTarget and t.dist > (State.farm.standDist + 2) then
				World.nearTo(t.pos, State.farm.standDist)
				task.wait(0.1)
			end
			local hold = t.prompt.HoldDuration or 0
			local ok = false
			if rem then
				if hold > 0 then
					ok = select(1, pcall(function() rem:FireServer(t.prompt, "PullStart") end))
					task.wait(math.min(hold, 3) + 0.06)
					if t.prompt.Parent then pcall(function() rem:FireServer(t.prompt) end) end
				else
					ok = select(1, pcall(function() rem:FireServer(t.prompt) end))
				end
			elseif hasFirePrompt then
				ok = select(1, pcall(fireproximityprompt, t.prompt))
			end
			if ok then
				count = count + 1
				Farm.stats.harvested = Farm.stats.harvested + 1
			end
			task.wait(State.farm.harvestDelay)
		end
	end
	if count > 0 then UI.setStatus("🍈 เก็บเกี่ยวแล้ว " .. count .. " ผล", "#9be86a") end
	return count
end

-- ── เติมน้ำที่บ่อ ──
function Farm.refillWater()
	local wellPos = World.wellPos()
	if not wellPos then
		UI.setStatus("⚠️ ไม่พบบ่อน้ำในสวน (ต้องซื้อ Water Well ก่อน)", "#ffd45e")
		return false
	end
	local hrp = World.hrp()
	if hrp and (hrp.Position - wellPos).Magnitude > 12 then
		World.nearTo(wellPos, 6)
		task.wait(0.15)
	end
	local before = tonumber(player:GetAttribute("WaterUses")) or 0
	-- เกมยิง Water ที่ตำแหน่งตัวเองตอนน้ำหมด = เติมที่บ่อ
	HUB.Fire("Water", "Water", (World.pos() or wellPos))
	local t0 = os.clock()
	while os.clock() - t0 < 3 do
		task.wait(0.2)
		local now = tonumber(player:GetAttribute("WaterUses")) or 0
		if now > before then
			UI.setStatus("💧 เติมน้ำแล้ว (" .. now .. " ครั้ง)", "#7fd4ff")
			return true
		end
	end
	UI.setStatus("⚠️ เติมน้ำไม่สำเร็จ (อาจต้องยืนใกล้บ่อมากขึ้น)", "#ffd45e")
	return false
end

-- ── รดน้ำ ──
function Farm.waterOnce()
	local can = World.toolByGear("WateringCan")
	if not can then
		UI.setStatus("⚠️ ไม่พบบัวรดน้ำในกระเป๋า", "#ffd45e")
		return 0
	end
	World.equip(can)
	local uses = tonumber(player:GetAttribute("WaterUses")) or 0
	if uses <= 0 and State.farm.refill then
		Farm.refillWater()
		uses = tonumber(player:GetAttribute("WaterUses")) or 0
	end
	if uses <= 0 then return 0 end
	local spots = World.plantSpots(State.farm.onlyMine, State.farm.reachDist)
	if #spots == 0 then
		UI.setStatus("🌱 ไม่พบต้นที่รดน้ำได้", "#c8c8d2")
		return 0
	end
	local watered = 0
	for _, s in ipairs(spots) do
		if not HUB.Alive or not State.farm.water then break end
		if watered >= uses then break end
		local hrp = World.hrp()
		local aimPos = s.pos
		if hrp then
			local flat = Vector3.new(hrp.Position.X - s.pos.X, 0, hrp.Position.Z - s.pos.Z)
			if flat.Magnitude > 0.1 then aimPos = s.pos + flat.Unit * 1.2 end
		end
		if State.farm.tpToTarget and s.dist > (State.farm.standDist + 2) then
			World.nearTo(s.pos, State.farm.standDist)
			task.wait(0.1)
			hrp = World.hrp()
			if hrp then
				local flat2 = Vector3.new(hrp.Position.X - s.pos.X, 0, hrp.Position.Z - s.pos.Z)
				if flat2.Magnitude > 0.1 then aimPos = s.pos + flat2.Unit * 1.2 end
			end
		end
		if HUB.Fire("Water", "Water", aimPos) then
			watered = watered + 1
			Farm.stats.watered = Farm.stats.watered + 1
		end
		task.wait(State.farm.waterDelay)
	end
	if watered > 0 then UI.setStatus("💧 รดน้ำ " .. watered .. " แปลง", "#7fd4ff") end
	return watered
end

-- ── ขาย ──
function Farm.sellTruck()
	if not World.inOwnTruck() then return false end
	if HUB.Fire("Cargo", "Sell") then
		Farm.stats.sold = Farm.stats.sold + 1
		UI.setStatus("🚚 ขายขึ้นรถแล้ว", "#ffd45e")
		return true
	end
	return false
end

function Farm.sellStall()
	local rem = HUB.Remote("SellDurians")
	if not rem then return false end
	local kinds = { "All", "LumpAll", "PalmAll" }
	local fired = 0
	for _, k in ipairs(kinds) do
		if pcall(function() rem:FireServer(k) end) then fired = fired + 1 end
		task.wait(0.08)
	end
	if fired > 0 then UI.setStatus("🏪 ส่งคำสั่งขายที่แผงแล้ว", "#ffd45e") end
	return fired > 0
end

-- ── Rebirth ──
function Farm.tryRebirth(force)
	local rebirths = World.rebirths()
	local cfg = HUB.Config("RebirthConfig")
	local maxR = (cfg and cfg.MaxRebirths) or 25
	if rebirths >= maxR then
		UI.setStatus("🔮 Rebirth เต็มแล้ว (" .. rebirths .. "/" .. maxR .. ")", "#c084ff")
		return false
	end
	local cost = World.rebirthCost()
	local cash = World.cash()
	if not force and cash < cost then return false end
	local res = HUB.Invoke("Rebirth")
	Farm.stats.rebirths = Farm.stats.rebirths + 1
	UI.setStatus("🔮 Rebirth! (เงิน " .. tostring(cash) .. " / ต้องการ " .. tostring(cost) .. ")", "#c084ff")
	HUB.Notify("Rebirth สำเร็จครั้งที่ " .. tostring(World.rebirths()), "ok")
	return true
end

-- ── รับทุเรียนร่วง (Catch minigame) ──
function Farm.catchStep()
	local char = World.char()
	if not char then return false end
	if not char:GetAttribute("CatchStart") then return false end
	if char:GetAttribute("CatchLock") then return true end
	local targetVal = char:FindFirstChild("CatchTarget")
	local target = targetVal and targetVal.Value
	if not (target and target.Parent) then return true end
	local ok, cf = pcall(function() return target:GetBoundingBox() end)
	if not ok then return true end
	local hrp = World.hrp()
	local hum = World.hum()
	if hum then pcall(function() hum:MoveTo(Vector3.new(cf.Position.X, hrp and hrp.Position.Y or cf.Position.Y, cf.Position.Z)) end) end
	if State.farm.tpToTarget and hrp then
		World.teleportTo(Vector3.new(cf.Position.X, hrp.Position.Y, cf.Position.Z), 0)
	end
	return true
end

-- ── Master loop ──
function Farm.loop()
	task.spawn(function()
		while HUB.Alive and task.wait(0.15) do
			local ok, err = pcall(function()
				if not State.farm.master then return end
				if not World.hrp() then return end
				if State.farm.autoCatch then Farm.catchStep() end
				if State.farm.harvest then Farm.harvestOnce(30) end
				if State.farm.water then Farm.waterOnce() end
				if State.farm.sellStall then Farm.sellStall() end
				if State.farm.sellTruck then Farm.sellTruck() end
				if State.farm.rebirth and (os.clock() - Farm.lastRebirthTry) > State.farm.rebirthEvery then
					Farm.lastRebirthTry = os.clock()
					Farm.tryRebirth(false)
				end
			end)
			if not ok then HUB.Log("farm loop: " .. tostring(err), "error") end
			task.wait(State.farm.cycleDelay)
		end
	end)
end

