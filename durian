-- ── Fly ──
function Mods.startFly()
	local hrp = World.hrp()
	if not hrp then HUB.Notify("ยังไม่พร้อม (ไม่มีตัวละคร)", "warn") return false end
	Mods.stopFly(true)
	local att = new("Attachment", { Name = "HubFlyAtt" }, hrp)
	local velObj = nil
	local okLV, lv = pcall(function()
		local v = Instance.new("LinearVelocity")
		v.Attachment0 = att
		v.MaxForce = math.huge
		v.RelativeTo = Enum.ActuatorRelativeTo.World
		v.VectorVelocity = Vector3.new(0, 0, 0)
		v.Parent = hrp
		return v
	end)
	if okLV and lv then
		velObj = lv
	else
		local okBV, bv = pcall(function()
			local b = Instance.new("BodyVelocity")
			b.MaxForce = Vector3.new(1e6, 1e6, 1e6)
			b.P = 1e4
			b.Velocity = Vector3.new(0, 0, 0)
			b.Parent = hrp
			return b
		end)
		if okBV then velObj = bv end
	end
	Mods.flyParts = { att = att, vel = velObj, isLV = (velObj == lv) }
	Mods.flyConn = track(RunService.RenderStepped:Connect(function()
		if not State.playerMods.fly then return end
		local h = World.hrp()
		if not h then return end
		local hum = World.hum()
		local md = (hum and hum.MoveDirection) or Vector3.new(0, 0, 0)
		local spd = State.playerMods.flySpeed
		local dir = Vector3.new(md.X, 0, md.Z)
		if dir.Magnitude > 1 then dir = dir.Unit end
		local up = (Mods.upHeld and 1 or 0) - (Mods.downHeld and 1 or 0)
		local target = dir * spd + Vector3.new(0, up * spd, 0)
		local v = Mods.flyParts.vel
		if v and v.Parent then
			if Mods.flyParts.isLV then v.VectorVelocity = target else v.Velocity = target end
		else
			pcall(function() h.AssemblyLinearVelocity = target end)
		end
	end))
	State.playerMods.fly = true
	if UI.FlyPad then UI.FlyPad.Visible = true end
	UI.setStatus("🕊️ Fly เปิดอยู่ (ใช้ปุ่ม ▲▼ บินขึ้น/ลง)", "#7fd4ff")
	HUB.Notify("เปิด Fly แล้ว", "ok")
	return true
end

function Mods.stopFly(silent)
	State.playerMods.fly = false
	if Mods.flyConn then pcall(function() Mods.flyConn:Disconnect() end) Mods.flyConn = nil end
	for _, key in ipairs({ "att", "vel" }) do
		local o = Mods.flyParts[key]
		if o and o.Parent then o:Destroy() end
	end
	Mods.flyParts = {}
	local hrp = World.hrp()
	if hrp then pcall(function() hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end) end
	if UI.FlyPad then UI.FlyPad.Visible = false end
	Mods.upHeld, Mods.downHeld = false, false
	if not silent then HUB.Notify("ปิด Fly แล้ว", "info") end
end

function Mods.wireFlyButtons()
	if not (UI.FlyUp and UI.FlyDown) then return end
	local function wire(btn, isUp)
		track(btn.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
				if isUp then Mods.upHeld = true else Mods.downHeld = true end
				HUB.Tween(btn, 0.1, { BackgroundColor3 = HUB.Accent })
			end
		end))
		track(btn.InputEnded:Connect(function()
			if isUp then Mods.upHeld = false else Mods.downHeld = false end
			HUB.Tween(btn, 0.18, { BackgroundColor3 = Theme.body })
		end))
	end
	wire(UI.FlyUp, true)
	wire(UI.FlyDown, false)
end

