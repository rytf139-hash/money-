--  14) CONFIG (บันทึก/โหลดด้วย writefile ถ้า executor รองรับ)
-- ══════════════════════════════════════════════════════════════
local Config = {}
HUB.Config2 = Config
Config.fileName = "DurianFarmHub_Config.json"
Config.canFile = (typeof(writefile) == "function" and typeof(readfile) == "function" and typeof(isfile) == "function")

function Config.serialize()
	return {
		ui = State.ui, farm = State.farm, fish = State.fish, reward = State.reward,
		esp = State.esp, playerMods = State.playerMods,
		saved = State.teleport.saved,
		version = HUB.Version,
	}
end

function Config.save()
	if not State.ui.autoSave or not Config.canFile then return false end
	local ok, json = pcall(function() return HttpService:JSONEncode(Config.serialize()) end)
	if not ok then return false end
	pcall(function() writefile(Config.fileName, json) end)
	return true
end

function Config.load()
	if not Config.canFile then return false end
	local exists = false
	pcall(function() exists = isfile(Config.fileName) end)
	if not exists then return false end
	local content
	pcall(function() content = readfile(Config.fileName) end)
	if not content then return false end
	local ok, data = pcall(function() return HttpService:JSONDecode(content) end)
	if not (ok and type(data) == "table") then return false end
	for _, section in ipairs({ "ui", "farm", "fish", "reward", "esp", "playerMods" }) do
		if type(data[section]) == "table" then
			for k, v in pairs(data[section]) do
				if State[section][k] ~= nil and type(State[section][k]) == type(v) then
					State[section][k] = v
				end
			end
		end
	end
	if type(data.saved) == "table" then
		State.teleport.saved = {}
		for _, s in ipairs(data.saved) do
			if type(s) == "table" and s.name and s.x then
				table.insert(State.teleport.saved, { name = s.name, x = s.x, y = s.y, z = s.z })
			end
		end
	end
	return true
end

