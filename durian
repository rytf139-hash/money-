				task.delay(0.2, function() if not obj.open then listBox.Visible = false end end)
				if obj.onChange then pcall(obj.onChange, idv, text) end
			end))
			table.insert(obj.rows, { btn = r, id = idv, text = text })
		end
	end
	rebuild()
	function obj:SetOptions(list2) rebuild(list2) end
	function obj:Set(v, silent)
		obj.value = v
		for _, r in ipairs(obj.rows) do if r.id == v then val.Text = r.text end end
		if not silent and obj.onChange then pcall(obj.onChange, v) end
	end
	track(btn.Activated:Connect(function()
		obj.open = not obj.open
		if obj.open then
			listBox.Visible = true
			local h = #obj.rows * 40 + 8
			HUB.Tween(listBox, 0.24, { Size = UDim2.new(1, -8, 0, h) }, Enum.EasingStyle.Back)
			HUB.Tween(arrow, 0.24, { Rotation = 180 })
		else
