function World.pickBait()
	local cfg = HUB.Config("FishingConfig")
	local baits = (cfg and cfg.Baits) or { { Id = "Worm" }, { Id = "Shrimp" }, { Id = "Golden" } }
	local sel = player:GetAttribute("FishSel")
	if sel and (tonumber(player:GetAttribute("Bait_" .. tostring(sel))) or 0) > 0 then return sel end
	for _, b in ipairs(baits) do
		if b and b.Id and (tonumber(player:GetAttribute("Bait_" .. b.Id)) or 0) > 0 then return b.Id end
	end
	return nil
end

