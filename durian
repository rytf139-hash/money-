	new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }, listBox)
	pad(4, 4, 4, 4, listBox)

	local obj = { value = opts.default or options[1], onChange = opts.callback, open = false }
	obj.rows = {}
	local function rebuild(list2)
		for _, r in ipairs(listBox:GetChildren()) do if r:IsA("TextButton") then r:Destroy() end end
		obj.rows = {}
		for i, o in ipairs(list2 or options) do
			local text = type(o) == "table" and (o.name or o.Name or tostring(o.id)) or tostring(o)
