	local function refreshSaved()
		for _, c in ipairs(savedBox:GetChildren()) do
			if c:IsA("TextButton") or c:IsA("TextLabel") or c:IsA("Frame") then c:Destroy() end
		end
		if #State.teleport.saved == 0 then
			local l = new("TextLabel", {
				Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1, Text = "ยังไม่มีจุดบันทึก",
				TextColor3 = Theme.muted, TextSize = 12, Font = Enum.Font.Gotham, LayoutOrder = 0,
			}, savedBox)
		else
			for i, s in ipairs(State.teleport.saved) do
				listButton(savedBox, s.name, "📍", function()
					TP.toPos(Vector3.new(s.x, s.y, s.z), s.name)
				end, i, Theme.purple, Theme.purpleDark)
			end
		end
	end
	refreshSaved()
	local saveBtns = listContainer(page)
	listButton(saveBtns, "บันทึกตำแหน่งที่ยืนอยู่", "💾", function()
		TP.saveHere(nil)
		refreshSaved()
		HUB.Notify("บันทึกจุดแล้ว (ทั้งหมด " .. #State.teleport.saved .. " จุด)", "ok")
	end)
	listButton(saveBtns, "ล้างจุดที่บันทึกทั้งหมด", "🗑️", function()
		State.teleport.saved = {}
		refreshSaved()
		Config.save()
		HUB.Notify("ล้างจุดบันทึกแล้ว", "info")
	end, nil, Theme.red, Color3.fromRGB(120, 20, 20))

	W.section(page, "สแกนหาจุดในแมพ")
	local scanBox = listContainer(page)
	local scanInfo = W.label(page, "กดปุ่มสแกนเพื่อหา Well / Market / Shop / Garage / Fish / Spawn ฯลฯ ในแมพ", { height = 30 })
	local scanBtns = listContainer(page)
	listButton(scanBtns, "🔍 สแกนแมพหาจุดวาร์ป", "🔍", function()
		scanInfo.Text = "กำลังสแกนแมพ... (อาจใช้เวลา 1-3 วินาที)"
		task.defer(function()
			local found = World.scanLandmarks(60)
			for _, c in ipairs(scanBox:GetChildren()) do
				if c:IsA("TextButton") then c:Destroy() end
			end
			if #found == 0 then
				scanInfo.Text = "ไม่พบจุดที่เข้าข่ายในแมพ"
				return
			end
			scanInfo.Text = "พบ " .. #found .. " จุด — กดเพื่อวาร์ป"
			local myPos = World.pos()
			for i, f in ipairs(found) do
				local d = myPos and math.floor((f.pos - myPos).Magnitude) or 0
				listButton(scanBox, f.name .. "  (" .. d .. "m)", "📍", (function(pos, nm)
					return function() TP.toPos(pos, nm) end
				end)(f.pos, f.name), i, Theme.row, Theme.ink)
			end
		end)
	end)
	return page
end

