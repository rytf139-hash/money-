--  5) REMOTES (แคช + หาแบบปลอดภัย)
-- ══════════════════════════════════════════════════════════════
local RemoteCache = {}
local RemoteMissing = {}
local function remotesFolder()
	return ReplicatedStorage:FindFirstChild("Remotes") or ReplicatedStorage:WaitForChild("Remotes", 20)
end
function HUB.Remote(name, timeout)
	if RemoteCache[name] and RemoteCache[name].Parent then return RemoteCache[name] end
	-- ถ้าเคยหาไม่เจอ ให้ลองใหม่ทุก 15 วิ (เผื่อเกมโหลด remote ช้า)
	if RemoteMissing[name] and (os.clock() - (RemoteMissing[name] or 0)) < 15 then return nil end
	local folder = remotesFolder()
	local rem = folder and (folder:FindFirstChild(name) or folder:WaitForChild(name, timeout or 3))
	if rem then
		RemoteCache[name] = rem
		RemoteMissing[name] = nil
		return rem
	end
	if not RemoteMissing[name] then
		HUB.Log("ไม่พบ remote: " .. name .. " (จะลองใหม่ใน 15 วิ)", "error")
	end
	RemoteMissing[name] = os.clock()
	return nil
end

function HUB.Fire(name, ...)
	local rem = HUB.Remote(name)
	if not rem then return false end
	-- หมายเหตุ: ใช้ pcall(f, ...) ตรง ๆ เพราะ '...' ใช้ใน closure ซ้อนไม่ได้
	local ok, err = pcall(rem.FireServer, rem, ...)
	if not ok then HUB.Log("ยิง " .. name .. " พลาด: " .. tostring(err), "error") end
	return ok
end

function HUB.Invoke(name, ...)
	local rem = HUB.Remote(name)
	if not rem then return nil end
	local packed = { pcall(rem.InvokeServer, rem, ...) }
	if not packed[1] then return nil end
	return packed[2]
end

-- config modules ของเกม (require แบบปลอดภัย)
local ConfigCache = {}
function HUB.Config(name)
	if ConfigCache[name] ~= nil then return ConfigCache[name] end
	local shared = ReplicatedStorage:FindFirstChild("Shared")
	local mod = shared and shared:FindFirstChild(name)
	local ok, res = false, nil
	if mod then ok, res = pcall(require, mod) end
	ConfigCache[name] = (ok and type(res) == "table") and res or false
	return ConfigCache[name]
end

