local function new(className, props, parent)
	local inst = Instance.new(className)
	if props then
		for k, v in pairs(props) do
			if k ~= "Parent" then
				local ok, err = pcall(function() inst[k] = v end)
				if not ok then warn("[HUB] set " .. tostring(k) .. " fail: " .. tostring(err)) end
			end
		end
	end
	if parent then inst.Parent = parent end
	return inst
end

function HUB.Log(text, kind)
	local stamp = os.date("%H:%M:%S")
	local line = "[" .. stamp .. "] " .. tostring(text)
	table.insert(HUB.LogLines, 1, line)
	while #HUB.LogLines > 80 do table.remove(HUB.LogLines) end
	if HUB.OnLog then pcall(HUB.OnLog, line, kind) end
	if kind == "error" then warn(line) end
end

function HUB.Notify(text, kind)
	if HUB.OnNotify and State.ui.notify then pcall(HUB.OnNotify, text, kind) end
end

-- tween helper ที่respect ความเร็ว tween ในตั้งค่า
function HUB.Tween(obj, time, props, style, dir)
	local t = clamp(time / (State.ui.tweenSpeed or 1), 0.01, 10)
	local tw = TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

-- springy: อนิเมชันกดแบบเดียวกับในเกม (MouseEnter/Leave/Down/Up + Touch)
function HUB.Springy(gui, hoverScale, pressScale)
	local press = gui:FindFirstChild("Press")
	if not (press and press:IsA("UIScale")) then
		press = new("UIScale", { Name = "Press", Scale = 1 }, gui)
	end
	hoverScale = hoverScale or 1.04
	pressScale = pressScale or 0.92
	local hovering = false
	local function to(scale, time, style)
		HUB.Tween(press, time, { Scale = scale }, style or Enum.EasingStyle.Quad)
	end
	track(gui.MouseEnter:Connect(function() hovering = true  to(hoverScale, 0.12) end))
	track(gui.MouseLeave:Connect(function() hovering = false to(1, 0.12) end))
	track(gui.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			to(pressScale, 0.06)
		end
	end))
	track(gui.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			to(hovering and hoverScale or 1, 0.28, Enum.EasingStyle.Back)
		end
	end))
	return press
end

-- PopIn / PopOut แบบ UIKit ของเกม
function HUB.PopIn(gui)
	local pop = gui:FindFirstChild("Pop")
	if not (pop and pop:IsA("UIScale")) then pop = new("UIScale", { Name = "Pop", Scale = 1 }, gui) end
	gui:SetAttribute("PopState", "Opening")
	gui.Visible = true
	pop.Scale = 0.6
	local tw = TweenService:Create(pop, TweenInfo.new(0.3 / (State.ui.tweenSpeed or 1), Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
	tw:Play()
	track(tw.Completed:Once(function()
		if gui:GetAttribute("PopState") == "Opening" then
			gui:SetAttribute("PopState", "Open")
			pop.Scale = 1
		end
	end))
	return tw
end

function HUB.PopOut(gui, done)
	local pop = gui:FindFirstChild("Pop")
	if not (pop and pop:IsA("UIScale")) then pop = new("UIScale", { Name = "Pop", Scale = 1 }, gui) end
	gui:SetAttribute("PopState", "Closing")
	local tw = TweenService:Create(pop, TweenInfo.new(0.14 / (State.ui.tweenSpeed or 1), Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0.7 })
	tw:Play()
	track(tw.Completed:Once(function()
		if gui:GetAttribute("PopState") == "Closing" then
			gui.Visible = false
			gui:SetAttribute("PopState", "Closed")
			pop.Scale = 1
			if done then done() end
		end
	end))
	return tw
end

