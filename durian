	W.label(page, string.format(
		'<font color="#c084ff">🌾 %s v%s</font>\nแพลตฟอร์ม: %s  •  ระบบสัมผัส: %s\nExecutor writefile: %s\nFPS: -',
		HUB.Name, HUB.Version, HUB.Platform, HUB.IsTouch and "ใช่" or "ไม่ใช่", Config.canFile and "ใช้ได้" or "ไม่ได้"
	), { bg = Theme.track, height = 74, color = Theme.muted, size = 12 })
	return page
end

-- ══════════════════════════════════════════════════════════════
--  18) INIT
-- ══════════════════════════════════════════════════════════════
local function init()
	local ok, err = pcall(function()
		Config.load()

		UI.build()
		if UI.GuiScale then UI.GuiScale.Scale = State.ui.scale or 1 end
		UI.centerWindow()
		UI.setAccent(State.ui.accent or "purple")
		UI.makeDraggable(UI.Window, UI.TopBar)
		UI.makeLauncherDraggable()

		track(UI.CloseBtn.Activated:Connect(function() UI.setOpen(false) end))
		track(UI.MinBtn.Activated:Connect(function() UI.setOpen(false) end))

		-- คีย์ลัด (PC / emulator ที่มีคีย์บอร์ด)
		track(UserInputService.InputBegan:Connect(function(input, gpe)
			if gpe then return end
			if input.KeyCode == Enum.KeyCode.RightShift or input.KeyCode == Enum.KeyCode.F1 then
				UI.setOpen(not UI.Open)
			elseif input.KeyCode == Enum.KeyCode.RightControl and State.playerMods.fly then
				Mods.stopFly()
			end
		end))

		Mods.wireFlyButtons()
		Mods.wireInfJump()
		Mods.applyStats()
		Mods.statLoop()
		Mods.autoEquipLoop()
		ESP.watchPlayers()

		buildFarmTab()
		buildFishTab()
		buildRewardTab()
		buildEspTab()
		buildTpTab()
		buildPlayerTab()
		buildSettingsTab()
		UI.selectTab("farm")

		Farm.loop()
		Fish.loop()
		Rewards.loop()
		ESP.loop()
		UI.statusLoop()

		-- กันหน้าต่างหลุดจอเมื่อหมุนจอ/ย่อแอป
		task.spawn(function()
			while HUB.Alive and task.wait(2) do
				pcall(function()
					camera = Workspace.CurrentCamera or camera
					if not (UI.Window and UI.Window.Parent) then return end
					local vp = camera and camera.ViewportSize
					if not vp then return end
					local size = UI.Window.AbsoluteSize
					if size.X > vp.X - 8 or size.Y > vp.Y - 8 then
						local w, h = UI.windowSize()
						UI.Window.Size = UDim2.fromOffset(w, h)
					end
					UI.clampWindow()
				end)
			end
		end)

		if State.playerMods.fly then task.delay(1.2, function() if HUB.Alive then Mods.startFly() end end) end
		if State.playerMods.noClip then task.delay(0.5, function() if HUB.Alive then Mods.startNoClip() end end) end

		UI.setOpen(true)

		HUB.Log("โหลด " .. HUB.Name .. " v" .. HUB.Version .. " สำเร็จ  (" .. HUB.Platform .. ")", "ok")
		HUB.Log("พบ remote: " .. (HUB.Remote("HarvestFruit") and "HarvestFruit ✓" or "HarvestFruit ✗")
			.. " / " .. (HUB.Remote("Water", 2) and "Water ✓" or "Water ✗")
			.. " / " .. (HUB.Remote("Fishing", 2) and "Fishing ✓" or "Fishing ✗")
			.. " / " .. (HUB.Remote("Rebirth", 2) and "Rebirth ✓" or "Rebirth ✗"))
		local base = World.myBase()
		HUB.Log("สวนของเรา: " .. (base and base.Name or "ยังไม่พบ (อาจยังไม่ได้รับแปลง)"))
		HUB.Notify("🌾 " .. HUB.Name .. " พร้อมใช้งาน!", "ok")
		HUB.Notify("กดปุ่มลอย 🌾 เพื่อเปิด/ปิด  •  ลากแถบหัวเพื่อย้ายหน้าต่าง", "info")
	end)
	if not ok then
		warn("[สวนทุเรียน HUB] โหลดพลาด: " .. tostring(err))
		HUB.Log("โหลดพลาด: " .. tostring(err), "error")
	end
end

init()

return HUB
