-- ── ลากหน้าต่าง ──
function UI.makeDraggable(frame, handle)
	local dragging, dragInput, dragStart, startPos
	track(handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragInput = input
			dragStart = input.Position
			startPos = frame.Position
		end
	end))
	track(handle.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local d = input.Position - dragStart
			frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end))
	track(handle.InputEnded:Connect(function(input)
		if input == dragInput then
			dragging = false
			UI.clampWindow()
		end
	end))
	track(UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local d = input.Position - dragStart
			frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end))
end

function UI.clampWindow()
	local vp = (camera and camera.ViewportSize) or Vector2.new(1366, 768)
	local inset = select(2, pcall(function() return GuiService:GetGuiInset() end))
	local topInset = (type(inset) == "Vector2" and inset.Y) or 0
	local scale = (UI.GuiScale and UI.GuiScale.Scale) or 1
	local size = UI.Window.AbsoluteSize
	local pos = UI.Window.AbsolutePosition
	local x = clamp(pos.X, 4, math.max(4, vp.X - size.X - 4))
	local y = clamp(pos.Y, topInset + 2, math.max(topInset + 2, vp.Y - 44))
	if math.abs(x - pos.X) > 1 or math.abs(y - pos.Y) > 1 then
		UI.Window.Position = UDim2.fromOffset(x / scale, y / scale)
	end
end

-- ── ปุ่มลอย: ลาก + snap ขอบจอ ──
function UI.makeLauncherDraggable()
	local launcher = UI.Launcher
	local dragging, moved, dragInput, dragStart, startPos
	track(launcher.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging, moved = true, false
			dragInput = input
			dragStart = input.Position
			startPos = launcher.Position
			HUB.Tween(UI.LauncherScale, 0.12, { Scale = 1.12 }, Enum.EasingStyle.Back)
		end
	end))
	track(launcher.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local d = input.Position - dragStart
			if d.Magnitude > 6 then moved = true end
			launcher.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end))
	local function endDrag(input)
		if input == dragInput and dragging then
			dragging = false
			HUB.Tween(UI.LauncherScale, 0.22, { Scale = 1 }, Enum.EasingStyle.Back)
			if moved then
				local vp = (camera and camera.ViewportSize) or Vector2.new(1366, 768)
				local p = launcher.AbsolutePosition
				local size = launcher.AbsoluteSize
				local left = p.X < (vp.X / 2)
				local x = left and 8 or (vp.X - size.X - 8)
				local y = clamp(p.Y, 60, vp.Y - size.Y - 20)
				HUB.Tween(launcher, 0.28, { Position = UDim2.fromOffset(x, y) }, Enum.EasingStyle.Back)
			end
		end
	end
	track(launcher.InputEnded:Connect(endDrag))
	track(launcher.Activated:Connect(function()
		if not moved then UI.setOpen(not UI.Open) end
	end))
end

-- ══════════════ สถานะ / FPS ══════════════
function UI.statusLoop()
	task.spawn(function()
		local frames, lastT = 0, os.clock()
		local fps = 60
		track(RunService.RenderStepped:Connect(function()
			frames = frames + 1
			local now = os.clock()
			if now - lastT >= 0.5 then
				fps = math.floor(frames / (now - lastT))
				frames, lastT = 0, now
			end
		end))
		while HUB.Alive and task.wait(0.4) do
			camera = Workspace.CurrentCamera or camera
			if UI.StatusBar and UI.StatusBar.Parent then
				local cash = World.cash()
				local rb = World.rebirths()
				local water = tonumber(player:GetAttribute("WaterUses")) or 0
				local ripe = #CollectionService:GetTagged("DurianFruit")
				UI.StatusBar.Text = string.format(
					'<font color="#ffd45e">💰 %s</font>   <font color="#c084ff">🔮 R%d</font>   <font color="#7fd4ff">💧 %d</font>   <font color="#9be86a">🍈 %d</font>',
					tostring(cash), rb, water, ripe
				)
			end
			UI.FpsText = fps
			if UI.FpsLabel and UI.FpsLabel.Parent then UI.FpsLabel.Text = fps .. " FPS" end
		end
	end)
end

