-- สวน/ฐานของเรา: workspace.Map.Bases[x].OwnerUserId == UserId
function World.myBase()
	local map = Workspace:FindFirstChild("Map")
	local bases = map and map:FindFirstChild("Bases")
	if not bases then bases = Workspace:FindFirstChild("Bases") end
	if not bases then return nil end
	for _, b in ipairs(bases:GetChildren()) do
		if b:GetAttribute("OwnerUserId") == player.UserId then return b end
	end
	return nil
end

function World.baseOf(inst)
	local node = inst
	while node and node.Parent do
		if node.Parent.Name == "Bases" then return node end
		node = node.Parent
	end
	return nil
end

function World.isMine(inst)
	local base = World.baseOf(inst)
	if not base then return false end
	return base:GetAttribute("OwnerUserId") == player.UserId
end

-- อุปกรณ์ตาม GearId (Rod / WateringCan / Shovel / WaterGun / Sprayer / Disinfect_*)
function World.toolByGear(gearId, prefix)
	local places = { player.Character, player:FindFirstChild("Backpack") }
	for _, place in ipairs(places) do
		if place then
			for _, t in ipairs(place:GetChildren()) do
				if t:IsA("Tool") then
					local g = t:GetAttribute("GearId")
					if type(g) == "string" then
						if prefix then
							if g:sub(1, #gearId) == gearId then return t end
						elseif g == gearId then
							return t
						end
					end
				end
			end
		end
	end
	return nil
end

function World.equip(tool)
	if not tool then return false end
	local hum = World.hum()
	if not hum then return false end
	if tool.Parent == player.Character then return true end
	tool.Parent = player.Character
	task.wait(0.05)
	pcall(function() hum:EquipTool(tool) end)
	task.wait(0.08)
	return true
end

function World.inOwnTruck()
	local hum = World.hum()
	local seat = hum and hum.SeatPart
	if not (seat and seat:IsA("VehicleSeat")) then return nil end
	local model = seat:FindFirstAncestorWhichIsA("Model")
	while model and not model:GetAttribute("VehicleId") do
		model = model.Parent and model.Parent:FindFirstAncestorWhichIsA("Model")
	end
	if model and model:GetAttribute("OwnerUserId") == player.UserId then return model end
	return nil
end

-- ── เทเลพอร์ต / เดิน ────────────────────────────────────────
local lastTp = 0
function World.teleportTo(target, yOffset)
	local hrp = World.hrp()
	if not hrp then return false end
	local cf
	if typeof(target) == "CFrame" then
		cf = target
	elseif typeof(target) == "Vector3" then
		cf = CFrame.new(target + Vector3.new(0, yOffset or 3.2, 0))
	elseif typeof(target) == "Instance" then
		local pivot = (target.GetPivot and target:GetPivot()) or nil
		cf = pivot or CFrame.new(target.Position + Vector3.new(0, yOffset or 3.2, 0))
	else
		return false
	end
	local now = os.clock()
	if now - lastTp < 0.04 then task.wait(0.04) end
	lastTp = os.clock()
	local ok = pcall(function()
		if player.Character and player.Character.PrimaryPart then
			player.Character:PivotTo(cf)
		else
			hrp.CFrame = cf
		end
		hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
	end)
	return ok
end

function World.walkTo(pos, timeout)
	local hum = World.hum()
	if not (hum and pos) then return false end
	hum:MoveTo(pos)
	return true
end

-- เข้าไปให้ใกล้จุด (วาร์ปถ้าไกลเกิน / เดินถ้าใกล้) แบบนุ่ม ๆ
function World.nearTo(pos, dist, allowTp)
	dist = dist or 6
	local hrp = World.hrp()
	if not (hrp and pos) then return false end
	local flat = Vector3.new(hrp.Position.X - pos.X, 0, hrp.Position.Z - pos.Z)
	if flat.Magnitude <= dist then return true end
	if allowTp == false then
		World.walkTo(pos)
		local t0 = os.clock()
		while os.clock() - t0 < 8 do
			local h2 = World.hrp()
			if not h2 then return false end
			local d2 = Vector3.new(h2.Position.X - pos.X, 0, h2.Position.Z - pos.Z).Magnitude
			if d2 <= dist then return true end
			task.wait(0.15)
		end
		return false
	end
	local dir = flat.Magnitude > 0.2 and -flat.Unit or Vector3.new(0, 0, -1)
	local stand = pos + dir * math.max(2.5, dist * 0.6)
	World.teleportTo(Vector3.new(stand.X, pos.Y, stand.Z), 3.2)
	task.wait(0.08)
	return true
end

-- ── ผลไม้ที่เก็บได้ ──────────────────────────────────────────
function World.ripePromptOf(fruit)
	local part = fruit:FindFirstChildWhichIsA("BasePart", true)
	local prompt = part and part:FindFirstChild("Harvest")
	if not (prompt and prompt:IsA("ProximityPrompt")) then return nil end
	if not prompt.Enabled then return nil end
	if prompt:GetAttribute("Unripe") then return nil end
	if fruit:GetAttribute("CatchBy") then return nil end
	return prompt, part
end

function World.harvestTargets(onlyMine, maxDist)
	local out = {}
	local myPos = World.pos()
	if not myPos then return out end
	maxDist = maxDist or 1e9

	-- (1) ผลที่แท็ก DurianFruit (ตรงกับที่เกมใช้)
	local tagged = CollectionService:GetTagged("DurianFruit")
	for _, fruit in ipairs(tagged) do
		local prompt, part = World.ripePromptOf(fruit)
		if prompt and part then
			if not onlyMine or World.isMine(fruit) then
				local d = (part.Position - myPos).Magnitude
				if d <= maxDist then
					table.insert(out, { prompt = prompt, part = part, model = fruit, dist = d, pos = part.Position, kind = fruit:GetAttribute("FruitId") or "Durian" })
				end
			end
		end
	end

	-- (2) fallback: พรอมป์ชื่อ Harvest/Collect ที่ยังไม่ได้แท็ก (แคช 4 วิ กันกระตุก)
	if #out == 0 then
		local now = os.clock()
		if World._fbCache and (now - World._fbCacheT) < 4 then
			for _, e in ipairs(World._fbCache) do
				if e.prompt and e.prompt.Parent then
					local d = (e.pos - myPos).Magnitude
					if d <= maxDist and (not onlyMine or World.isMine(e.part)) then
						table.insert(out, { prompt = e.prompt, part = e.part, model = e.model, dist = d, pos = e.pos, kind = e.kind })
					end
				end
			end
			return out
		end
		local fb = {}
		local map = Workspace:FindFirstChild("Map") or Workspace
		local scanned = 0
		for _, d in ipairs(map:GetDescendants()) do
			scanned = scanned + 1
			if scanned > 30000 then break end
			if d:IsA("ProximityPrompt") and d.Enabled and (d.Name == "Harvest" or d.Name == "Collect" or d.Name == "Pick") then
				local holder = d.Parent
				if holder and holder:IsA("BasePart") then
					if not onlyMine or World.isMine(holder) then
						local dist = (holder.Position - myPos).Magnitude
						table.insert(fb, { prompt = d, part = holder, model = holder.Parent, dist = dist, pos = holder.Position, kind = "Prompt" })
					end
				end
			end
		end
		World._fbCache = fb
		World._fbCacheT = now
		for _, e in ipairs(fb) do
			local d = (e.pos - myPos).Magnitude
			if d <= maxDist and (not onlyMine or World.isMine(e.part)) then
				table.insert(out, { prompt = e.prompt, part = e.part, model = e.model, dist = d, pos = e.pos, kind = e.kind })
			end
		end
	end
	return out
end

-- ── แปลงปลูก (PlantSpot ที่มี Tree/Seed) ─────────────────────
function World.plantSpots(onlyMine, maxDist)
	local out = {}
	local myPos = World.pos()
	if not myPos then return out end
	maxDist = maxDist or 1e9
	local roots = {}
	local bases = Workspace.Map and Workspace.Map:FindFirstChild("Bases")
	if onlyMine then
		local mine = World.myBase()
		if mine then table.insert(roots, mine) end
	else
		if bases then roots = bases:GetChildren() end
	end
	for _, root in ipairs(roots) do
		for _, d in ipairs(root:GetDescendants()) do
			if d.Name == "PlantSpot" and d:IsA("BasePart") then
				local parent = d.Parent
				if parent and (parent:FindFirstChild("Tree") or parent:FindFirstChild("Seed")) then
					local dist = (d.Position - myPos).Magnitude
					if dist <= maxDist then
						table.insert(out, { spot = d, dist = dist, pos = d.Position, parent = parent })
					end
				end
			end
		end
	end
	table.sort(out, function(a, b) return a.dist < b.dist end)
	return out
end

-- ── บ่อน้ำ (Well) ในสวนเรา ───────────────────────────────────
function World.well()
	local base = World.myBase()
	if not base then return nil end
	local direct = base:FindFirstChild("Well", true)
	if direct then return direct end
	for _, d in ipairs(base:GetDescendants()) do
		local n = d.Name
		if type(n) == "string" and (n:lower():find("well")) and (d:IsA("BasePart") or d:IsA("Model")) then
			return d
		end
	end
	return nil
end

function World.wellPos()
	local w = World.well()
	if not w then return nil end
	if w:IsA("Model") then
		local ok, pivot = pcall(function() return w:GetPivot() end)
		return ok and pivot.Position or nil
	end
	return w.Position
end

-- ── บ่อปลา (จาก attribute ของผู้เล่น) ────────────────────────
function World.pond()
	local c = player:GetAttribute("PondCenter")
	local r = player:GetAttribute("PondRadius")
	if typeof(c) == "Vector3" and type(r) == "number" then return c, r end
