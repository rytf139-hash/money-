-- Flow
------------------------------------------------------------
local function mainFlow()
	setStatus("กำลังฟาร์ม")
	if flatDist(M.root.Position, CONFIG.P2) <= 8 then
		-- skip enter
	else
		if not enterShop() then return "❌ เข้า Shop ไม่สำเร็จ" end
	end
	if not alive() then return end
	if applied then
		-- skip
	else
		if flatDist(M.root.Position, CONFIG.P2) > 6 then
			setStep("🚶 ไปจุดสมัครงาน (P2)")
			goToFree(CONFIG.P2, 3)
		end
		if not alive() then return end
		applyStep()
	end
	if not alive() then return end

	local failStreak, noSpotTicks = 0, 0
	while alive() do
		sessionCheck()  -- 🎲
		checkDepositRequests()
		if not alive() then return end
		if not findBoxTool() then
			setStep("🚶 ไปโซนรับกล่อง")
			local boxTarget = getBoxPickupTarget()
			local success = false
			if boxTarget then
				success = walkViaDoor(boxTarget, 3)
			else
				local interior = getInterior()
				if interior then
					local ok, cf = pcall(function() return interior:GetPivot() end)
					if ok then success = walkViaDoor(cf.Position, 3) end
				end
			end
			if success then
				failStreak = 0
				if not pickupBox() then
					log("รับกล่องไม่สำเร็จ ลองใหม่")
					task.wait(1)
				end
			else
				failStreak += 1
				task.wait(2)
				if failStreak >= 2 then
					failStreak = 0
					enterShop()
				end
			end
		else
			equipBox()
			local spots = shelfSpots()
			if #spots == 0 then
				noSpotTicks += 1
				task.wait(2)
			else
				noSpotTicks = 0
				for _, sp in ipairs(spots) do
					if not alive() or not findBoxTool() then break end
					equipBox()
					humanPause()  -- 🎲
					setStep(("🗄 ไปชั้น #%d (%s)"):format(sp.idx, sp.name))
					if goTo(sp.pos, 3, true) then
						setStep(("⏳ ยืนรอวางกล่อง ชั้น #%d"):format(sp.idx))
						local ok = standUntilStock(CONFIG.StockTimeout, sp.pos)
						log(ok and ("✅ วางกล่องแล้ว ชั้น #%d"):format(sp.idx)
							or ("หมดเวลา ที่ชั้น #%d"):format(sp.idx))
					end
					task.wait(0.4)
					checkDepositRequests()
				end
			end
		end
		task.wait(0.2)
	end
end

local function depositOnlyFlow()
	setStatus("ฝากเงิน")
	maybeDeposit(true)
	return "เสร็จ"
end

------------------------------------------------------------
-- Start / Stop
------------------------------------------------------------
local function cleanupMover()
	noclipEnd()
	G.pts = nil
	if M.tween then M.tween:Cancel() end
	if M.conn then M.conn:Disconnect() end
	if M.watch then M.watch:Disconnect() M.watch = nil end
	pcall(function() RunService:UnbindFromRenderStep("AutoFarmMove") end)
	M.moveDir = nil
	if M.hum and M.hum.Parent then
		M.hum:Move(Vector3.zero, false)
		if M.prevSpeed then M.hum.WalkSpeed = M.prevSpeed end
	end
	if M.root and M.root.Parent then
		M.root.AssemblyLinearVelocity = Vector3.zero
		M.root.AssemblyAngularVelocity = Vector3.zero
	end
	if M.cfv then M.cfv:Destroy() end
	M.cfv, M.conn, M.tween = nil, nil, nil
end
local function stopRun(msg)
	if not S.running and not M.cfv then return end
	S.running = false
	S.runId += 1
	cleanupMover()
	setStatus(msg or "หยุดแล้ว")
	setStep("-")
end

local function startStuckWatchdog(myId)
	task.spawn(function()
		local lastPos, lastMove = nil, os.clock()
		local strikes, lastStrike = 0, 0
		while S.running and S.runId == myId do
			task.wait(0.25)
			local root, cfv, hum = M.root, M.cfv, M.hum
			if not (S.unstick and root and root.Parent and cfv and hum and hum.Health > 0) then
				lastPos, lastMove = nil, os.clock()
				continue
			end
			local now = os.clock()
			local pos = root.Position
			local travelling = (M.travel or 0) > 0 and not M.unstick
			if not travelling or not lastPos or (pos - lastPos).Magnitude > 1.5 then
				lastPos, lastMove = pos, now
			elseif now - lastMove >= CONFIG.StuckTime then
				local goal = G.target
				local flat = goal and flatUnit(goal - pos) or nil
				if not flat then flat = flatUnit(root.CFrame.LookVector) or Vector3.new(0,0,-1) end
				strikes = (now - lastStrike < 15) and (strikes + 1) or 1
				lastStrike = now
				local dist = CONFIG.UnstickDist * strikes
				if goal then dist = math.min(dist, math.max(flatDist(pos, goal), 3)) end
				local dest = pos + flat * dist
				local gy = groundAt(dest.X, dest.Z, pos.Y)
				local y = (gy and math.abs(gy + hoverH - pos.Y) <= 6) and (gy + hoverH) or pos.Y
				dest = Vector3.new(dest.X, y, dest.Z)
				log(("🛟 ติด %d วิ -> Tween %.0f studs"):format(CONFIG.StuckTime, dist))
				M.unstick = true
				M.pulled = true
				if M.tween then M.tween:Cancel() end
				cfv.Value = root.CFrame
				noclipBegin()
				local T = math.max((dest - pos).Magnitude / math.max(CONFIG.Speed, 24), 0.15)
				local tw = TweenService:Create(cfv, TweenInfo.new(T, Enum.EasingStyle.Linear),
					{ Value = CFrame.lookAt(dest, dest + flat) })
				M.tween = tw
				tw:Play()
				tw.Completed:Wait()
				noclipEnd()
				M.unstick = false
				M.pulled = true
				lastPos, lastMove = root.Position, os.clock()
			end
		end
	end)
end

local function startRun(flow)
	if S.running then return end
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (hum and root) or hum.Health <= 0 then setStatus("❌ ไม่พบตัวละคร") return end
	if hum.SeatPart then setStatus("❌ ลงจากที่นั่งก่อน") return end
	S.running = true
	S.runId += 1
	M = { char = char, hum = hum, root = root, id = S.runId, prevSpeed = hum.WalkSpeed }
	hum.Died:Connect(function() applied = false end)
	local ignore = { char }
	for _,pl in ipairs(Players:GetPlayers()) do
		if pl.Character and pl.Character ~= char then table.insert(ignore, pl.Character) end
	end
	rayParams.FilterDescendantsInstances = ignore
	local pos0 = root.Position
	local g0 = Workspace:Raycast(pos0 + Vector3.new(0,3,0), Vector3.new(0,-300,0), rayParams)
	hoverH = g0 and math.clamp(pos0.Y - g0.Position.Y, 1.5, 6)
		or math.clamp(hum.HipHeight + root.Size.Y/2, 1.5, 6)
	local cfv = Instance.new("CFrameValue")
	cfv.Value = root.CFrame
	M.cfv = cfv
	M.conn = cfv.Changed:Connect(function(v)
		if root.Parent then
			root.CFrame = v
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
		end
	end)
	M.lastPullLog = 0
	M.watch = RunService.Heartbeat:Connect(function()
		if not alive() or not M.cfv then return end
		if os.clock() < (M.ignoreUntil or 0) then return end
		local d = (root.Position - M.cfv.Value.Position).Magnitude
		if d > CONFIG.PullThreshold then
			M.pulled = true
			if M.tween then M.tween:Cancel() end
			M.moveDir = nil
			M.cfv.Value = root.CFrame
			if os.clock() - M.lastPullLog > 2 then
				M.lastPullLog = os.clock()
				log(("โดนดึง %d studs -> คิดใหม่"):format(d))
			end
		end
	end)
	RunService:BindToRenderStep("AutoFarmMove", Enum.RenderPriority.Input.Value + 1, function()
		if M.moveDir and hum.Parent then hum:Move(M.moveDir, false) end
	end)
	local myId = S.runId
	startStuckWatchdog(myId)
	task.spawn(function()
		threadRun[coroutine.running()] = myId
		local ok, res = pcall(flow)
		if not ok then log("error: " .. tostring(res)) end
		if S.runId == myId then
			stopRun(ok and (res or "จบการทำงาน") or "❌ error (ดู Log)")
		end
	end)
end

player.CharacterAdded:Connect(function(char)
	applied = false
	if S.running then stopRun("เกิดใหม่") end
	if S.auto then
		char:WaitForChild("HumanoidRootPart", 10)
		task.wait(CONFIG.ResumeDelay)
		if S.auto and not S.running then startRun(mainFlow) end
	end
end)

