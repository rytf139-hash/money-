task.spawn(function()
	local last = {}
	local function push(key, setter, value)
		if last[key] ~= value then last[key] = value setter(value) end
	end
	while true do
		task.wait(1.0 + math.random() * 0.8)  -- 🎲 poll สุ่ม
		local hand, bank = getMoney()
		push("hand", setHand, ("$%s"):format(fmt(hand)))
		push("bank", setBank, ("$%s"):format(fmt(bank)))
		push("dres", setDStatus, lastResult)
		push("fs", setFStatus, UI.status)
		push("fst", setFStep, UI.step)
	end
end)

