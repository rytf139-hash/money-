local ncSaved = nil
local function noclipBegin()
	if ncSaved or not M.char then return end
	ncSaved = {}
	for _,d in ipairs(M.char:GetDescendants()) do
		if d:IsA("BasePart") then
			ncSaved[d] = d.CanCollide
			d.CanCollide = false
		end
	end
end
local function noclipEnd()
	if not ncSaved then return end
	for part, v in pairs(ncSaved) do
		if part.Parent then part.CanCollide = v end
	end
	ncSaved = nil
end

-- 🎲 tweenTo มี jitter + speed สุ่ม
local function tweenTo(p, heading)
	local w0 = os.clock()
	while M.unstick and alive() and os.clock() - w0 < 8 do task.wait(0.05) end
	-- jitter ตำแหน่ง (0.2-0.6 studs)
	local jitter = Vector3.new(
		(math.random() - 0.5) * 0.6,
		0,
		(math.random() - 0.5) * 0.6
	)
	local dest = p + jitter
	local cfv = M.cfv
	local cur = cfv.Value.Position
	M.moveDir = heading
	local spd = randSpeed()
	M.hum.WalkSpeed = spd
	local T = math.max((dest - cur).Magnitude / spd, 0.03)
	T = T * (0.85 + math.random() * 0.3)  -- 🎲 ±15%
	if M.tween then M.tween:Cancel() end
	M.tween = TweenService:Create(cfv, TweenInfo.new(T, Enum.EasingStyle.Linear),
		{ Value = CFrame.lookAt(dest, dest + heading) })
	M.tween:Play()
	task.wait(math.max(T - LEAD, 0.01))
end

local function hopOver(curRoot, pRoot, rise, heading)
	noclipBegin()
	local n = math.max(5, math.ceil((pRoot - curRoot).Magnitude / 3))
	for k = 1, n do
		if not alive() or M.pulled then break end
		local t = k / n
		local base = curRoot:Lerp(pRoot, t)
		tweenTo(Vector3.new(base.X, base.Y + rise * math.sin(math.pi * t), base.Z), heading)
	end
	noclipEnd()
end

