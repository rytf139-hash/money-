local cachedDoorPos, cachedDoors = nil, {}
local function captureDoorPos()
	local ds = getDoorSystem()
	if ds then
		local list, positions = {}, {}
		for _,d in ipairs(ds:GetDescendants()) do
			if d:IsA("BasePart") then
				positions[#positions+1] = d.Position
				list[#list+1] = { pos = d.Position, cf = d.CFrame, size = d.Size }
			end
		end
		if #positions > 0 then
			cachedDoors = list
			local sum = Vector3.zero
			for _,p in ipairs(positions) do sum += p end
			cachedDoorPos = sum / #positions
			return cachedDoorPos
		end
		if ds:IsA("Model") then
			local ok,cf = pcall(function() return ds:GetPivot() end)
			if ok and cf then cachedDoorPos = cf.Position return cachedDoorPos end
		end
	end
	return cachedDoorPos
end

