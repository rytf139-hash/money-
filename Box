local function getATM()
	local i = getInterior()
	return i and i:FindFirstChild("ATM")
end

-- หา 1 จุดที่ยืนข้าง ATM
local function findATMSpot()
	local atm = getATM()
	if not atm then return nil end
	local apos = posOf(atm)
	if not apos then return nil end
	local rootPos = M.root.Position
	local feetY = rootPos.Y - hoverH
	local pts = {}
	for k = 0, 7 do
		local a = math.rad(k*45)
		local x, z = apos.X + math.cos(a)*4, apos.Z + math.sin(a)*4
		local gy = groundAt(x, z, rootPos.Y)
		if gy and math.abs(gy - feetY) < 2.5 then
			local p = Vector3.new(x, gy + hoverH, z)
			pts[#pts+1] = { pos = p, d = flatDist(p, rootPos) }
		end
	end
	table.sort(pts, function(a,b) return a.d < b.d end)
	return pts, apos
end

-- ฝากเงินวนจนกว่าเงินในมือ < เกณฑ์ (สุ่มทีละ 100-500)
local function depositLoopAtATM()
	local total = 0
	local iter = 0
	local results = {}
	while alive() and iter < 40 do
		iter += 1
		local hand = getMoney()
		if hand < Cfg.Threshold then break end
		local amount = computeDepositOnce(hand)
		if amount <= 0 then break end
		setStep(("💰 ฝากสุ่ม $%s"):format(fmt(amount)))
		if depositAmount(amount) then
			total += amount
			depositCount += 1
			results[#results+1] = amount
			lastResult = ("✅ ฝาก $%s (รวม $%s)"):format(fmt(amount), fmt(total))
			log(lastResult)
			-- 🎲 หน่วงระหว่างการฝากแต่ละครั้ง (humanize)
			task.wait(0.6 + math.random() * 1.0)
		else
			lastResult = ("❌ ฝาก $%s ล้มเหลว"):format(fmt(amount))
			log(lastResult)
			break
		end
	end
	if total > 0 then
		totalDeposited += total
		lastResult = ("✅ ฝากรวม $%s สำเร็จ (%d ครั้ง)"):format(fmt(total), #results)
		log(lastResult)
		return true
	end
	return false
end

local function depositAtATM()
	local atm = getATM()
	if not atm then
		lastResult = "❌ ไม่พบ ATM"
		log(lastResult)
		return false
	end
	local promptOk = false
	for _,d in ipairs(atm:GetDescendants()) do
		if d:IsA("ProximityPrompt") and d.Enabled then promptOk = true break end
	end
	if not promptOk then
		lastResult = "❌ ATM ไม่พร้อมใช้งาน"
		log(lastResult)
		return false
	end
	setStep("🏧 ไปตู้ ATM")
	local pts, apos = findATMSpot()
	local reached = false
	for _,p in ipairs(pts or {}) do
		if not alive() then return false end
		if goToFree(p.pos, 3) then reached = true break end
	end
	if not reached and apos and alive() then
		reached = goToFree(apos, 3)
	end
	if not reached then
		lastResult = "❌ ไป ATM ไม่ได้"
		log(lastResult)
		return false
	end
	task.wait(0.3)
	-- ฝากวน
	return depositLoopAtATM()
end

local function maybeDeposit(force)
	if not (Cfg.AutoOn or force) then return end
	local hand = getMoney()
	if hand < Cfg.Threshold then
		if force then lastResult = "⚠ ยังไม่ถึงเกณฑ์" end
		return
	end
	if not force and os.clock() - lastDepositTry < Cfg.Cooldown then return end
	lastDepositTry = os.clock()
	log(("เงินในมือ $%s ถึงเกณฑ์ -> ไป ATM"):format(fmt(hand)))
	if not depositAtATM() then
		lastDepositTry = os.clock() + 10
	end
end

local function checkDepositRequests()
	if S.depositNow then
		S.depositNow = false
		maybeDeposit(true)
	else
		maybeDeposit(false)
	end
end

