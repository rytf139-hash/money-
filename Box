	local mins = (os.clock() - H.sessionStart) / 60
	if mins >= H.maxSessionMin then
		local d = H.restMin + math.random() * (H.restMax - H.restMin)
		log(("😴 ครบ %.0f นาที -> พัก %.0f นาที (กันแบน)"):format(mins, d))
		setStatus(("😴 พัก %.0f นาที"):format(d))
		setStep("-")
		task.wait(d * 60)
		H.sessionStart = os.clock()
	end
