    if cf and root then
        pcall(function()
            root.CFrame = cf
        end)
        tpCooldown = true
        notify("📍", "คุณอยู่ที่นั่นแล้ว! ✨", 2)
        task.wait(0.5)
        tpCooldown = false
    else
        notify("📍", "ไม่สามารถไปที่นั่นได้! 😢", 2)
    end
end

